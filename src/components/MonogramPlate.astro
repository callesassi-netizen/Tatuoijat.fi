---
/**
 * Monogram-/mönsterplatta för profiler utan egna bilder (Bildpolicy §2).
 * Genereras deterministiskt från namnet: initialer i Archivo Black på
 * bläck-gradient med ett subtilt mönster i brand-tonerna.
 * Featured: guldring runt monogram-cirkeln + dotwork-textur.
 * Default-läget dag 1 — får ALDRIG se trasigt ut.
 */
interface Props {
  name: string;
  featured?: boolean;
}

const { name, featured = false } = Astro.props;

const words = name.trim().split(/\s+/);
const initials =
  words.length >= 2
    ? (words[0]![0]! + words[words.length - 1]![0]!).toUpperCase()
    : name.slice(0, 2).toUpperCase();

// Deterministisk variation per namn
const hash = [...name].reduce((acc, ch) => (acc * 31 + ch.charCodeAt(0)) >>> 0, 7);
const patterns = ['lines', 'dots', 'arcs', 'grid'] as const;
const pattern = patterns[hash % patterns.length];

// Bläck-gradienter i olika valörer (#1e1e1e → #3a2a2e-spannet, lyft för mörk bas 10/8 2026)
const inkStops = [
  ['#1e1e1e', '#2e2429'],
  ['#201e27', '#3c2b2b'],
  ['#23202a', '#452f2e'],
] as const;
const [inkFrom, inkTo] = inkStops[hash % inkStops.length]!;
const uid = `mp${hash % 9973}`;
---

<span class="monogram-plate" role="img" aria-label={name}>
  <svg class="monogram-art" viewBox="0 0 320 320" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <defs>
    <linearGradient id={`${uid}-bg`} x1="0" y1="0" x2="0.7" y2="1">
      <stop offset="0" stop-color={inkFrom}></stop>
      <stop offset="1" stop-color={inkTo}></stop>
    </linearGradient>
    {
      pattern === 'lines' && (
        <pattern id={`${uid}-p`} width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <line x1="0" y1="0" x2="0" y2="14" stroke="#F2F2F2" stroke-width="1" />
        </pattern>
      )
    }
    {
      pattern === 'dots' && (
        <pattern id={`${uid}-p`} width="18" height="18" patternUnits="userSpaceOnUse">
          <circle cx="4" cy="4" r="1.4" fill="#F2F2F2" />
        </pattern>
      )
    }
    {
      pattern === 'arcs' && (
        <pattern id={`${uid}-p`} width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M0 40 A40 40 0 0 1 40 0" fill="none" stroke="#F2F2F2" stroke-width="1" />
        </pattern>
      )
    }
    {
      pattern === 'grid' && (
        <pattern id={`${uid}-p`} width="22" height="22" patternUnits="userSpaceOnUse">
          <path d="M22 0H0V22" fill="none" stroke="#F2F2F2" stroke-width="1" />
        </pattern>
      )
    }
    {
      featured && (
        <pattern id={`${uid}-dot`} width="11" height="11" patternUnits="userSpaceOnUse">
          <circle cx="2.5" cy="2.5" r="0.9" fill="#F2F2F2" />
        </pattern>
      )
    }
  </defs>
  <rect width="320" height="320" fill={`url(#${uid}-bg)`}></rect>
  <rect width="320" height="320" fill={`url(#${uid}-p)`} opacity="0.07"></rect>
  {/* Subtil dotwork-textur på featured-kortens mörka yta */}
  {featured && <rect width="320" height="320" fill={`url(#${uid}-dot)`} opacity="0.05"></rect>}
  <circle
    cx="160"
    cy="160"
    r="92"
    fill={inkFrom}
    stroke={featured ? '#C9A227' : '#F2F2F2'}
    stroke-opacity={featured ? '0.85' : '0.18'}
    stroke-width={featured ? '2' : '1.5'}
  ></circle>
  {featured && <circle cx="160" cy="160" r="86" fill="none" stroke="#C9A227" stroke-opacity="0.25" stroke-width="1"></circle>}
  </svg>
  <span class="monogram-initials" data-mono={initials} aria-hidden="true"></span>
</span>

<style>
  /* INITIALERNA LIGGER I ETT data-ATTRIBUT, INTE SOM TEXT (Calle 12/8 2026).
     De var tidigare ett <text> inne i SVG:n, och då plockade Google upp dem
     som sidtext. Sökresultatet för startsidan blev därför:

       "Tutustu studioihin ; AT. Aava Tattoo Keskusta, Turku ; AT. ArtWork
        Tattoo Kallio, Helsinki ; CT. Custom X Tattoo Keskusta, Lahti ..."

     — initialerna klistrade före varje studionamn. content: attr() renderar
     dem visuellt utan att de blir en textnod, och attributvärden hamnar inte
     i utdrag. attr() och inte en CSS-variabel: ett namn som O'Brien hade
     brutit strängen i `content: var(--x)`, medan attributvärdet inte behöver
     escapas alls.

     Plattan namnges fortfarande av aria-label på ytterelementet, så för en
     skärmläsare är den oförändrad — initialerna var ändå bara en upprepning
     av namnet som står intill. */
  .monogram-plate {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    /* Krävs för cqmin nedan: initialerna ska skala med plattan, som är
       190 px i ett kort och betydligt större på artistsidan. */
    container-type: size;
  }
  .monogram-art {
    display: block;
    width: 100%;
    height: 100%;
  }
  .monogram-initials {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    color: #edeae2;
    letter-spacing: 0.06em;
    /* Fallback för webbläsare utan container query units: en fast storlek som
       ser rimlig ut i kortformatet. Utan den vore plattan tom, och den får
       aldrig se trasig ut (Bildpolicy §2). */
    font-size: 44px;
    pointer-events: none;
  }
  @supports (font-size: 1cqmin) {
    .monogram-initials {
      /* 76/320 av SVG:ns viewBox — samma optiska storlek som förut. */
      font-size: 23.75cqmin;
    }
  }
  .monogram-initials::before {
    content: attr(data-mono);
  }
</style>
