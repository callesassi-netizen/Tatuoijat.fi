---
/**
 * Produktsektionen på oppaat/guider — AFFILIATE-READY, men tom på produkter.
 *
 * BESLUT (dokumenterat även i src/data/affiliate.ts):
 * En produkt utan `affiliateUrl` renderas INTE ALLS. Alternativet — ett grått,
 * icke-klickbart platshållarkort — läser som en trasig butik och sänker
 * sidans redaktionella trovärdighet, vilket är precis fel signal för en ny
 * domän som ska bli den citerade källan (GEO.md). I stället bär
 * KATEGORIBLOCKEN sektionen: de säger vad man ska titta efter i en produkt,
 * utan att nämna ett enda märke. De står på egna ben som innehåll i dag och
 * blir rubriker över riktiga produktkort den dag ett affiliateprogram är
 * godkänt — ingen omskrivning behövs.
 *
 * MÄRKNING: annonsmärkningen ("Mainoslinkki" / "Annonslänk") renderas FÖRST i
 * sektionen, före första kortet, och bara när minst en klickbar produkt finns.
 * Så länge listan är tom finns ingen märkning att visa — och inget att märka.
 */
import { Image } from 'astro:assets';
import { productImage } from '../lib/productImages';
import type { Locale } from '../i18n/ui';
import type { GuideProductCategory } from '../data/guides/types';
import {
  AFFILIATE_CTA,
  AFFILIATE_DISCLOSURE,
  affiliatePartners,
  hasLinkableProducts,
  linkableProducts,
  withEpi,
} from '../data/affiliate';

interface Props {
  locale: Locale;
  title: string;
  intro: string;
  categories: GuideProductCategory[];
  /** Guidens key — blir första ledet i epi (`{guide}-{kategori}`). */
  epiPrefix: string;
}

const { locale, title, intro, categories, epiPrefix } = Astro.props;

const disclosure = AFFILIATE_DISCLOSURE[locale];
const ctaLabel = AFFILIATE_CTA[locale];
const showDisclosure = hasLinkableProducts();

// Produkterna slås upp per kategori. Tom lista = bara kriterietexten renderas.
// epi sätts per KATEGORI, inte per produkt: frågan vi vill kunna svara på är
// "vilket block i vilken guide säljer", inte "vilken av två burkar salva".
// Fler epi-värden än så gör rapporten svårläst utan att ge mer att agera på.
const blocks = categories.map((category) => ({
  ...category,
  epi: `${epiPrefix}-${category.category}`,
  products: linkableProducts(category.category).map((product) => ({
    product,
    // Kan saknas: bilden hämtas av ett skript som medvetet inte fäller bygget
    // om butikens CDN strular. Kortet renderas då utan bild.
    image: productImage(product.id),
  })),
}));
---

<section aria-labelledby="products-title" class="block">
  <h2 class="block-title" id="products-title">{title}</h2>
  <p class="products-intro">{intro}</p>

  {
    showDisclosure && (
      <p class="disclosure">
        <span class="disclosure-label">{disclosure.label}</span>
        <span class="disclosure-text">{disclosure.text}</span>
      </p>
    )
  }

  <div class="product-categories">
    {
      blocks.map((block) => (
        <div class="product-category">
          <h3 class="product-category-title">{block.title}</h3>
          <p class="product-category-text">{block.text}</p>
          {block.products.length > 0 && (
            <ul class="product-list">
              {block.products.map(({ product, image }) => (
                <li class:list={['product-card', image && 'product-card--media']}>
                  {image && (
                    <span class="product-media">
                      <Image
                        src={image}
                        alt=""
                        widths={[120, 240]}
                        sizes="72px"
                        loading="lazy"
                        densities={undefined}
                      />
                    </span>
                  )}
                  <span class="product-body">
                    <span class="product-name">{product.name}</span>
                    <span class="product-shop">{affiliatePartners[product.partner].name}</span>
                    <span class="product-text">{product.description[locale]}</span>
                    <a
                      class="product-cta"
                      href={withEpi(product.affiliateUrl!, block.epi)}
                      rel="sponsored nofollow noopener"
                      target="_blank"
                    >
                      {ctaLabel}
                    </a>
                  </span>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))
    }
  </div>
</section>

<style>
  .products-intro {
    font-size: 14px;
    line-height: 1.6;
    color: var(--meta);
    margin: 0 0 20px;
    max-width: 640px;
  }

  .disclosure {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: var(--surface);
    border: var(--card-border);
    border-radius: var(--r-card);
    padding: 12px 14px;
    margin: 0 0 20px;
  }
  .disclosure-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--meta);
  }
  .disclosure-text {
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--text);
  }

  .product-categories {
    display: grid;
    gap: 16px;
  }
  .product-category {
    background: var(--surface);
    border: var(--card-border);
    border-radius: var(--r-card);
    padding: 16px 18px;
  }
  .product-category-title {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    color: var(--text);
    margin: 0;
  }
  .product-category-text {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--meta);
    margin: 6px 0 0;
  }

  .product-list {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .product-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    border-top: var(--card-border);
    padding-top: 12px;
  }
  /* Med bild blir kortet en rad: miniatyr vänster, text höger. Utan bild
     behåller det exakt sitt gamla utseende — layouten hänger alltså inte på
     att bildhämtningen lyckades. */
  .product-card--media {
    flex-direction: row;
    align-items: flex-start;
    gap: 12px;
  }
  .product-media {
    flex: none;
    width: 72px;
    /* Fast kvadrat: höjden är reserverad innan bilden laddat, så inget hoppar.
       Produktbilder från feeds har vitt bakgrundstryck och blir därför en vit
       platta även i mörkt läge — det är rätt, inte en bugg. */
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #fff;
    border: var(--card-border);
    border-radius: 8px;
    padding: 5px;
  }
  .product-media :global(img) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }
  .product-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    min-width: 0;
  }
  .product-name {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text);
  }
  /* Butiken syns före klicket, inte efter. */
  .product-shop {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--meta);
  }
  .product-text {
    font-size: 13px;
    line-height: 1.55;
    color: var(--meta);
  }
  .product-cta {
    margin-top: 4px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--flash);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }

  @media (min-width: 1024px) {
    .product-categories {
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }
  }
</style>
