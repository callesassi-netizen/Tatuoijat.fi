---
import Logo from './Logo.astro';
import { useTranslations, localePath, type Locale } from '../i18n/ui';
import { citiesIndexPath, guidesIndexPath, searchPath } from '../lib/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const p = (path: string) => localePath(locale, path);

// Markera aktiv sektion i navigationen
const currentPath = Astro.url.pathname;
const isActive = (prefix: string) => currentPath.startsWith(p(prefix));

const citiesBase = citiesIndexPath(locale);
const guidesBase = guidesIndexPath(locale);
const navLinks = [
  { href: p(citiesBase), label: t('nav.cities'), active: isActive(citiesBase) },
  { href: p('/tyylit/'), label: t('nav.styles'), active: isActive('/tyylit') },
  // Prisguiden /hinnat (konsument-SEO) — visas i BÅDE desktop- och mobilnav.
  { href: p('/hinnat/'), label: t('nav.prices'), active: isActive('/hinnat') },
  // Oppaat/Guider låg bara i footern; en hel innehållsgren utan väg in från
  // navigationen hittas i praktiken inte. Hubben är noindex tills tre guider
  // finns, men noindex,follow — länken passerar länkvärde till guiderna.
  { href: p(guidesBase), label: t('nav.guides'), active: isActive(guidesBase) },
  { href: p('/yhteys/'), label: t('nav.contact'), active: isActive('/yhteys') },
];
// "Studioille"-navet pekar på säljsidan /hinnasto (ansökningsformen /liity
// nås därifrån). Aktiv på båda B2B-sidorna.
const studioActive = isActive('/hinnasto') || isActive('/liity');
---

<header class="site-header">
  <div class="container header-inner">
    <details class="mobile-menu">
      <summary aria-label={t('nav.menu')}>
        <span class="burger" aria-hidden="true"><i></i><i></i><i></i></span>
      </summary>
      <nav class="mobile-panel">
        {
          navLinks.map((link) => (
            <a href={link.href} aria-current={link.active ? 'page' : undefined}>
              {link.label}
            </a>
          ))
        }
        <a href={p('/hinnasto/')} aria-current={studioActive ? 'page' : undefined}>
          {t('nav.forStudios')}
        </a>
      </nav>
    </details>

    <a class="home-link" href={p('/')}>
      <Logo locale={locale} />
      <span class="visually-hidden">{t('site.tagline')}</span>
    </a>

    <!-- Pekade tidigare på startsidans #haku-ankare, vilket bara fungerade
         från startsidan. Nu på sökSIDAN: samma ikon, men fungerar från
         varje sida på sajten och landar på ett fokuserat sökfält. -->
    <a class="search-link" href={p(searchPath(locale))} aria-label={t('nav.toSearch')}>
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <circle cx="8" cy="8" r="5.5" stroke="currentColor" stroke-width="1.6"></circle>
        <path d="M12.5 12.5L16 16" stroke="currentColor" stroke-width="1.6"></path>
      </svg>
    </a>

    <nav class="desktop-nav" aria-label={t('nav.menu')}>
      {
        navLinks.map((link) => (
          <a class="ink-link" href={link.href} aria-current={link.active ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
      <a class="pill" href={p('/hinnasto/')} aria-current={studioActive ? 'page' : undefined}>
        {t('nav.forStudios')}
      </a>
    </nav>
  </div>
</header>

<style>
  /* STICKY (Calle 10/8). z-index måste ligga över startsidans hero, som själv
     är sticky med z-index 0, och över arket som ligger på z-index 1. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--ink);
    color: var(--text-light);
    transition:
      transform var(--t-med) var(--ease-out),
      box-shadow var(--t-med) var(--ease-out),
      border-color var(--t-med) var(--ease-out);
    border-bottom: 1px solid transparent;
  }

  /* Bara när sidan faktiskt scrollats. Överst på sidan ska headern se ut som
     en del av heron, inte som ett pålagt fält. */
  .site-header.is-stuck {
    border-bottom-color: rgba(242, 242, 242, 0.12);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.45);
  }

  /* Auto-dölj vid scroll nedåt — MOBIL ENDAST. 83 % av besökarna är på mobil,
     där en permanent bar äter ~15 % av skärmhöjden i en 2 000 ords guide.
     Kommer tillbaka direkt vid minsta scroll uppåt. På desktop finns höjden,
     så där står headern kvar hela tiden. */
  .site-header.is-hidden {
    transform: translateY(-100%);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px var(--page-pad);
  }
  .home-link {
    text-decoration: none;
  }

  /* Mobil: hamburgare vänster, logo mitten, sökikon höger */
  .mobile-menu {
    position: relative;
  }
  .mobile-menu summary {
    list-style: none;
    display: flex;
    align-items: center;
    padding: 6px;
    margin: -6px;
    cursor: pointer;
  }
  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }
  .burger {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 20px;
  }
  .burger i {
    height: 2px;
    background: var(--text-light);
  }
  .burger i:last-child {
    width: 14px;
  }
  .mobile-panel {
    position: absolute;
    z-index: 20;
    top: calc(100% + 14px);
    left: calc(-1 * var(--page-pad) + 8px);
    min-width: 220px;
    display: flex;
    flex-direction: column;
    background: var(--ink);
    border: var(--hairline-dark);
    border-radius: var(--r-card);
    padding: 8px;
  }
  .mobile-panel a {
    color: var(--text-light);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    padding: 11px 14px;
    border-radius: 8px;
  }
  .mobile-panel a:hover {
    background: rgba(237, 234, 226, 0.08);
  }
  .mobile-panel a[aria-current='page'] {
    background: rgba(237, 234, 226, 0.1);
    font-weight: 700;
  }
  .search-link {
    color: var(--text-light);
    padding: 6px;
    margin: -6px;
  }

  .desktop-nav {
    display: none;
  }

  @media (min-width: 1024px) {
    .site-header.is-hidden {
      transform: none;
    }
    .header-inner {
      padding-top: 18px;
      padding-bottom: 18px;
    }
    .mobile-menu {
      display: none;
    }
    /* Sökikonen finns kvar på desktop och lägger sig intill navigationen
       (space-between skulle annars centrera den mitt i headern). */
    .search-link {
      margin-left: auto;
      margin-right: 22px;
    }
    .search-link:hover {
      opacity: 0.75;
    }
    .desktop-nav {
      display: flex;
      align-items: center;
      gap: 28px;
    }
    .desktop-nav a {
      color: var(--text-light);
      text-decoration: none;
      font-size: 13.5px;
      font-weight: 500;
    }
    .desktop-nav .pill {
      font-size: 12.5px;
      font-weight: 600;
      border: 1px solid rgba(237, 234, 226, 0.35);
      border-radius: var(--r-chip);
      padding: 8px 16px;
      transition:
        background-color var(--t-fast) ease-out,
        color var(--t-fast) ease-out;
    }
    .desktop-nav .pill:hover {
      background: var(--text-light);
      color: var(--ink);
    }
    /* Aktiv sida: permanent bläck-underline; Liity = ljus fylld pill (wireframe 3f) */
    .desktop-nav a[aria-current='page']:not(.pill)::after {
      transform: scaleX(1);
    }
    .desktop-nav .pill[aria-current='page'] {
      background: var(--text-light);
      border-color: var(--text-light);
      color: var(--ink);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
    /* En header som hoppar bort utan övergång läser som ett fel, inte som en
       gest. Med reducerad rörelse står den därför kvar. */
    .site-header.is-hidden {
      transform: none;
    }
  }
</style>

<script>
  // Sticky-headerns tre uppgifter: mäta sin egen höjd åt scroll-padding-top,
  // markera att sidan är scrollad, och gömma sig vid scroll nedåt på mobil.
  // Progressive enhancement: utan JS är headern fortfarande sticky, bara utan
  // auto-döljning, och scroll-padding faller tillbaka på 74 px.
  const header = document.querySelector('.site-header');
  const menu = document.querySelector('.mobile-menu');
  if (header instanceof HTMLElement) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const measure = () => {
      document.documentElement.style.setProperty('--header-h', `${header.offsetHeight}px`);
    };
    measure();
    window.addEventListener('resize', measure);
    // Webbfonterna byter höjd på logotypen när de laddat — mät om då.
    if (document.fonts?.ready) document.fonts.ready.then(measure);

    let lastY = window.scrollY;
    let ticking = false;

    const update = () => {
      ticking = false;
      const y = window.scrollY;
      const delta = y - lastY;

      header.classList.toggle('is-stuck', y > 8);

      // Gömning kräver tre saker: att vi är förbi headerns egen höjd (annars
      // gömmer den sig redan vid första hjulklicket), att rörelsen är
      // avsiktlig (> 6 px, filtrerar bort skakningar) och att menyn inte står
      // öppen — en öppen panel som glider ut ur bild är en bugg, inte en gest.
      const menuOpen = menu instanceof HTMLDetailsElement && menu.open;
      if (!reduceMotion && !menuOpen && y > header.offsetHeight * 1.5) {
        if (delta > 6) header.classList.add('is-hidden');
        else if (delta < -6) header.classList.remove('is-hidden');
      } else if (y <= header.offsetHeight * 1.5 || menuOpen) {
        header.classList.remove('is-hidden');
      }

      lastY = y;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );

    // Ankarklick i innehållsförteckningen: headern ska aldrig ligga över
    // rubriken man just hoppade till.
    document.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement | null)?.closest?.('a[href^="#"]');
      if (link) header.classList.remove('is-hidden');
    });
  }
</script>
