---
/**
 * Strukturerat intag-formulär på tack-sidorna.
 *
 * ⚠️ FORMULÄRNAMNET ÄNDRADES 2026-08-09 (docs/betalflode-analys-2026-08-09.md).
 * Tidigare delade det här formuläret Netlify-namnet "liity" med
 * ContactForm.astro. Netlify kopplar fältdefinitionen till NAMNET, så
 * intagets ~20 fält visades på vanliga kontaktinskick och tvärtom —
 * inkorgen blev oläslig och fält kunde tappas. Nu har intaget eget namn.
 *
 * INNAN DEPLOY: e-postnotisen i Netlify-dashboarden hänger PER
 * FORMULÄRNAMN. Notisen för NETLIFY_FORM_NAME nedan måste skapas
 * (Site configuration → Forms → Form notifications → Email notification,
 * välj formuläret, ange Calles adress) INNAN detta går live — annars
 * landar inskicken bara i Netlifys inkorg utan att något mejl skickas.
 * Det hände redan en gång (2026-07-15).
 *
 * NÖDBROMS: sätt NETLIFY_FORM_NAME tillbaka till 'liity' — en rad — så är
 * beteendet exakt som förut (rörig inkorg, men notis som fungerar).
 *
 * multipart/form-data för bilduppladdningen. Netlify avvisar POST över
 * 8 MB på CDN-nivå (kan inte höjas), därför storlekskontrollen i skriptet
 * längst ned. Fälten matchar studio-frontmatterns profilfält (betalflode-
 * och-kiitos.md). Granskning (bildtillstånd/kvalitet) sker fortfarande
 * innan bilderna läggs i galleriet (Bildpolicy).
 */
import type { Locale } from '../i18n/ui';
import type { PaidTier } from '../data/pricing';
import { intakeForm } from '../data/intakeForm';

/** Eget Netlify-formulärnamn för intaget — se blocket ovan. */
const NETLIFY_FORM_NAME = 'studiotiedot';

interface Props {
  locale: Locale;
  tier: PaidTier;
  styles: { id: string; name: string }[];
  /** Path (med locale-prefix) formuläret postar till efter lyckad submit. */
  action: string;
}

const { locale, tier, styles, action } = Astro.props;
const f = intakeForm[locale];
const artistSlots = tier === 'premium' ? [1, 2, 3] : [];
---

<form
  class="intake"
  name={NETLIFY_FORM_NAME}
  method="POST"
  enctype="multipart/form-data"
  data-netlify="true"
  netlify-honeypot="bot-field"
  action={action}
>
  <input type="hidden" name="form-name" value={NETLIFY_FORM_NAME} />
  <input type="hidden" name="aihe" value={`aloitus-${tier}`} />
  <input type="hidden" name="taso" value={tier} />
  <p class="hp" aria-hidden="true">
    <label>Bot field <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
  </p>

  <div class="form-field">
    <label for="if-studio">{f.studioName}</label>
    <input id="if-studio" name="studion_nimi" type="text" required autocomplete="organization" />
  </div>

  <div class="form-field">
    <label for="if-url">{f.profileUrl}</label>
    <input id="if-url" name="profiilin_url" type="text" required autocomplete="off" />
  </div>

  <div class="form-field">
    <label for="if-email">{f.email}</label>
    <input id="if-email" name="sahkoposti" type="email" required autocomplete="email" />
  </div>

  <div class="form-field">
    <label for="if-desc-fi">{f.descriptionFi}</label>
    <textarea id="if-desc-fi" name="kuvaus_fi" rows="3" required></textarea>
  </div>

  <div class="form-field">
    <label for="if-desc-sv">
      {f.descriptionSv} <span class="optional">{f.optional}</span>
    </label>
    <textarea id="if-desc-sv" name="kuvaus_sv" rows="3"></textarea>
  </div>

  <div class="form-field">
    <label for="if-phone">
      {f.phone} <span class="optional">{f.optional}</span>
    </label>
    <input id="if-phone" name="puhelin" type="tel" autocomplete="tel" />
  </div>

  <div class="form-field">
    <label for="if-hours">
      {f.hours} <span class="optional">{f.optional}</span>
    </label>
    <input id="if-hours" name="aukioloajat" type="text" placeholder={f.hoursPlaceholder} />
  </div>

  <div class="form-field">
    <label for="if-booking">
      {f.bookingUrl} <span class="optional">{f.optional}</span>
    </label>
    <input id="if-booking" name="booking_url" type="text" autocomplete="url" />
  </div>

  <fieldset class="form-field">
    <legend>{f.styles}</legend>
    <div class="checkbox-grid">
      {
        styles.map((style) => (
          <label class="checkbox-item">
            <input type="checkbox" name="tyylit" value={style.id} />
            {style.name}
          </label>
        ))
      }
    </div>
  </fieldset>

  {
    artistSlots.length > 0 && (
      <fieldset class="form-field">
        <legend>{f.extraArtistsTitle}</legend>
        <p class="field-hint">{f.extraArtistsHint}</p>
        {artistSlots.map((n) => (
          <div class="artist-row">
            <input name={`lisaartisti${n}_nimi`} type="text" placeholder={f.artistName} autocomplete="off" />
            <input name={`lisaartisti${n}_ig`} type="text" placeholder={f.artistInstagram} autocomplete="off" />
          </div>
        ))}
      </fieldset>
    )
  }

  <div class="form-field">
    <label for="if-photos">{f.photos}</label>
    <p class="field-hint">{f.photosHint[tier]}</p>
    <p class="field-hint">{f.sizeHint}</p>
    <input id="if-photos" name="kuvat" type="file" accept="image/*" multiple />
    <p class="size-warning" data-size-warning hidden>{f.sizeWarning}</p>
  </div>

  <label class="checkbox-item permission">
    <input type="checkbox" name="kuvat_lupa" value="kylla" required />
    {f.photoPermission}
  </label>

  <button class="btn-cta" type="submit">{f.submit}</button>
  <p class="form-note">{f.note}</p>
</form>

<script>
  // Netlify avvisar POST över 8 MB på CDN-nivå — gränsen går inte att höja
  // och gäller hela förfrågan, bilder inklusive. Utan den här kontrollen
  // fyller studion i ~20 fält, trycker skicka och möts av ett rått felsvar
  // med allt innehåll förlorat. Vi stoppar vid 7 MB för att lämna marginal
  // åt textfälten. Progressiv förbättring: utan JS är beteendet som förut.
  const MAX_UPLOAD_BYTES = 7 * 1024 * 1024;

  for (const form of document.querySelectorAll('form.intake')) {
    const fileInput = form.querySelector('input[type="file"]');
    const warning = form.querySelector('[data-size-warning]');
    if (!(fileInput instanceof HTMLInputElement) || !(warning instanceof HTMLElement)) continue;

    const withinLimit = () => {
      const total = Array.from(fileInput.files ?? []).reduce((sum, file) => sum + file.size, 0);
      const ok = total <= MAX_UPLOAD_BYTES;
      warning.hidden = ok;
      return ok;
    };

    fileInput.addEventListener('change', withinLimit);
    form.addEventListener('submit', (event) => {
      if (withinLimit()) return;
      event.preventDefault();
      warning.scrollIntoView({ block: 'center', behavior: 'smooth' });
    });
  }
</script>

<style>
  .intake {
    background: var(--surface);
    border: var(--card-border);
    border-radius: var(--r-card-lg);
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .hp {
    position: absolute;
    left: -9999px;
    margin: 0;
  }
  .form-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    border: 0;
    padding: 0;
    margin: 0;
  }
  .form-field label,
  .form-field legend {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--meta);
    padding: 0;
  }
  .optional {
    text-transform: none;
    letter-spacing: 0;
    font-weight: 500;
  }
  .form-field input,
  .form-field textarea {
    font-family: var(--font-body);
    /* 16px så iOS inte zoomar in vid fokus */
    font-size: 16px;
    color: var(--text);
    background: var(--paper);
    border: var(--card-border-strong);
    border-radius: var(--r-btn);
    padding: 11px 14px;
    width: 100%;
  }
  .form-field textarea {
    resize: vertical;
    min-height: 76px;
    line-height: 1.5;
  }
  .form-field input:focus-visible,
  .form-field textarea:focus-visible {
    outline: 2px solid var(--flash);
    outline-offset: 1px;
  }

  .checkbox-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px 12px;
    margin-top: 4px;
  }
  .checkbox-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0;
    color: var(--text);
    cursor: pointer;
  }
  .checkbox-item input {
    width: auto;
    accent-color: var(--flash);
  }
  .permission {
    line-height: 1.4;
  }

  .field-hint {
    font-size: 12px;
    color: var(--meta);
    margin: 2px 0 4px;
  }
  .size-warning {
    margin: 8px 0 0;
    padding: 9px 11px;
    border: 1px solid rgba(201, 162, 39, 0.55);
    border-radius: var(--r-btn);
    background: rgba(201, 162, 39, 0.09);
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--text);
  }
  .size-warning[hidden] {
    display: none;
  }
  .artist-row {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 8px;
  }
  .artist-row:first-of-type {
    margin-top: 0;
  }

  .form-note {
    font-size: 11.5px;
    color: var(--meta);
    text-align: center;
    margin: 0;
  }

  @media (min-width: 640px) {
    .artist-row {
      flex-direction: row;
    }
    .artist-row input {
      flex: 1;
    }
  }
</style>
