---
/**
 * Studioprofil (wireframe 3a mobil / 3e desktop): mörk identitets-hero,
 * flytande kontaktkort över skarven, portfolio som kärna, artisterna på
 * studion (med personliga IG-länkar), Tietoa och Luotettavuus.
 * Desktop: kontaktkort + info i höger sidopanel (340 px).
 * Utan bilder (Bildpolicy §2): monogram-platta + tydlig Instagram-länk —
 * får aldrig se trasigt ut. Kortets bild morphar hit via View Transition.
 */
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MonogramPlate from '../MonogramPlate.astro';
import InstagramEmbed from '../InstagramEmbed.astro';
import { useTranslations, localePath, type Locale } from '../../i18n/ui';
import {
  getCitiesSorted,
  getStylesSorted,
  getStudioArtists,
  isFeatured,
  isPaid,
  isVerified,
  localizedBody,
  cityDisplayName,
  styleDisplayName,
  getStyleCityPairs,
  getStudios,
  sortStudios,
} from '../../lib/content';
import { pricing } from '../../data/pricing';
import { jsonLdString, breadcrumbLd, tattooParlorLd, personLd, CONTENT_UPDATED } from '../../lib/schema';
import { citiesIndexPath, cityPath, styleCityPath, guidePath, guidesIndexPath } from '../../lib/routes';
import { guides } from '../../lib/guides.mjs';

interface Props {
  studio: CollectionEntry<'studios'>;
  locale: Locale;
}

/**
 * "a, b ja c" respektive "a, b och c". Ett komma före sista ledet vore fel på
 * båda språken, och en ren join(', ') läser som en tabell mitt i en mening.
 */
function listSentence(items: string[], loc: Locale): string {
  if (items.length <= 1) return items[0] ?? '';
  const last = items[items.length - 1]!;
  return `${items.slice(0, -1).join(', ')} ${loc === 'sv' ? 'och' : 'ja'} ${last}`;
}

const { studio, locale } = Astro.props;
const t = useTranslations(locale);
const p = (path: string) => localePath(locale, path);
const site = Astro.site!;
const { data } = studio;

const cities = await getCitiesSorted();
const styles = await getStylesSorted();
const city = data.city ? cities.find((entry) => entry.id === data.city) : undefined;
const cityName = city ? cityDisplayName(city, locale) : undefined;
const h1City = city && locale === 'fi' ? city.data.nameLocative : cityName;
// Utan matchande stadssida: visa seedens plats/region — aldrig tomt
const displayPlace = cityName ?? data.place ?? t('common.finland');

const styleNames = data.styles.map((slug) => {
  const style = styles.find((entry) => entry.id === slug);
  return style ? styleDisplayName(style, locale) : slug;
});

const bio = localizedBody(studio.body, locale);

/**
 * Utbyggnaden av profilen (12/8 2026) — se filhuvudets not. Allt nedan härleds
 * ur befintliga fält; ingenting hittas på.
 */

/** Stilarna med sin egen beskrivning och bästa möjliga vidarelänk. */
const styleDetails = data.styles
  .map((slug) => {
    const style = styles.find((entry) => entry.id === slug);
    if (!style) return null;
    const intro = localizedBody(style.body, locale);
    return {
      id: style.id,
      name: styleDisplayName(style, locale),
      // Första meningen räcker: profilen ska ge en aning om stilen, inte
      // upprepa hela stilsidan den länkar till.
      intro: intro ? `${intro.split(/(?<=\.)\s/)[0]}` : '',
      style,
    };
  })
  .filter((entry): entry is NonNullable<typeof entry> => entry !== null);

/**
 * Stil+stad-sidor genereras bara över en tröskel (getStyleCityPairs), så
 * länken måste kontrolleras — annars pekar profilen på en 404. Finns paret
 * inte faller vi tillbaka på stilsidan för hela landet.
 */
const stylePairs = await getStyleCityPairs();
const pairKeys = new Set(stylePairs.map((pair) => `${pair.styleId}:${pair.cityId}`));
const styleLinkFor = (styleId: string) =>
  city && pairKeys.has(`${styleId}:${city.id}`)
    ? styleCityPath(styleId, city, locale)
    : `/tyylit/${styleId}/`;

/** Andra liikkeet i samma stad — den överblick en katalog är ensam om. */
const allStudios = await getStudios();
const cityNeighbours = city
  ? sortStudios(
      allStudios.filter(
        (entry) => entry.data.city === city.id && entry.id !== studio.id,
      ),
    ).slice(0, 6)
  : [];

/**
 * De två guider som är mest relevanta FÖRE bokningen. Slås upp i registret så
 * att en slug-ändring inte lämnar 182 döda länkar efter sig, och hoppas över
 * tyst om guiden skulle avpubliceras.
 */
const profileGuides = [
  { key: 'tatuoinnin-kipu', label: t('artist.guidePain') },
  { key: 'ensimmainen-tatuointi', label: t('artist.guideFirst') },
]
  .map((entry) => {
    const route = guides.find(
      (guide) => guide.key === entry.key && guide.status === 'published',
    );
    return route ? { route, label: entry.label } : null;
  })
  .filter((entry): entry is { route: (typeof guides)[number]; label: string } => entry !== null);

/**
 * Sammanfattningen sätts ihop av hela meningar, inte av en mall med luckor.
 * Finskan böjer ortnamn (nameLocative) och stilnamn olika, och en mall som
 * försöker böja åt båda hållen blir fel för en finsk läsare. Varje mening är
 * därför grammatiskt komplett i sig och läggs bara till när fältet finns.
 */
const summarySentences = [
  h1City
    ? t('artist.summary.inCity', { name: data.name, city: h1City })
    : t('artist.summary.noCity', { name: data.name }),
  styleNames.length > 0
    ? t('artist.summary.styles', { styles: listSentence(styleNames, locale) })
    : '',
  data.ftaaMember ? t('artist.summary.ftaa') : '',
  data.walkIn ? t('artist.summary.walkIn') : '',
].filter(Boolean);

const placeLine = [data.district, displayPlace].filter(Boolean).join(', ');

// Artisterna (personerna) på studion. Ensam artist med samma namn som
// studion döljs i visningslistan — hens IG är redan studions kontaktväg —
// men räknas ändå med i embed-aggregeringen nedan (allStudioArtists).
const igUrl = (handle: string) => `https://instagram.com/${handle}`;
const allStudioArtists = await getStudioArtists(studio.id);
const persons = allStudioArtists.filter((person) => person.data.name !== data.name);
// Handle-only-artister (non-FTAA) — visas som @-chips; dubbletter mot
// personer och studions egen handle filtreras bort
const personHandles = new Set(
  persons.map((person) => person.data.instagram).filter(Boolean),
);
const extraHandles = data.artistInstagrams.filter(
  (handle) => !personHandles.has(handle) && handle !== data.instagram,
);
const hasArtistsSection = persons.length > 0 || extraHandles.length > 0;

// Nivåhärledning (matris): featured = premium, betald = pro|premium.
const paid = isPaid(studio);
const featured = isFeatured(studio);
const verified = isVerified(studio);
const claim = pricing[locale].claim;

const instagramUrl = data.instagram ? igUrl(data.instagram) : undefined;
// Cookiefri kartlänk (ingen embed/JS/cookies → noll CWV-kostnad): öppnar
// adressen i användarens kart-app. Endast när adress finns (annars dölj).
const mapHref = data.address
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(data.address)}`
  : undefined;
// Boka-tid-knapp ENDAST för betald nivå (matris: minimal kontakt på perus).
// Extern bokning först, annars studions hemsida.
const bookingHref = paid ? (data.bookingUrl ?? data.website ?? undefined) : undefined;
const phoneHref = paid && data.phone ? `tel:${data.phone.replace(/\s+/g, '')}` : undefined;
// Kontaktkortet visas när det finns något att visa (boka/tel/IG) eller när
// betald nivå får det cookiefria Netlify-kontaktformuläret.
const hasContact = Boolean(bookingHref || phoneHref || instagramUrl || paid);
const worksCount = data.images.length;
// Riktiga bilder vinner (Bildpolicy §2-tillstånd); annars max 2
// Instagram-embeds (handoff §8) — studions egna poster först, sedan
// artisternas (många multi-artist-studios saknar egen instagram-handle
// och har bara poster via sina artister); annars dagens monogram+IG-knapp.
const allEmbedPosts = [
  ...data.instagram_posts,
  ...allStudioArtists.flatMap((person) => person.data.instagram_posts),
];
const embedPosts = data.images.length === 0 ? allEmbedPosts.slice(0, 2) : [];
const displayWorksCount = data.images.length > 0 ? data.images.length : embedPosts.length;

const path = `/artistit/${studio.id}/`;
/**
 * Titeln kortas i steg tills den ryms i SERPen.
 *
 * Google klipper vid ungefär 60 tecken. Tvåstegsvarianten räckte inte: ett
 * namn som "Taide- ja tatuointipalvelut JohannArt Oy" är 40 tecken, och även
 * den korta mallen ("… — tyylit ja yhteystiedot") landade på 65. Analysen
 * 12/8 2026 hittade 40 sådana titlar.
 *
 * Stegen är sorterade efter vad som är värt mest när utrymmet tar slut. STADEN
 * offras SIST, inte först: "tatuointiliike {stad}" är en riktig sökning, medan
 * "tyylit ja yhteystiedot" bara beskriver sidan. Därför behåller steg 2 staden
 * och slänger beskrivningen — tvärtom mot den gamla ordningen.
 */
const titleCandidates = [
  t('artist.metaTitle', { name: data.name, city: displayPlace, site: t('site.name') }),
  displayPlace ? t('artist.metaTitleCity', { name: data.name, city: displayPlace }) : '',
  t('artist.metaTitleShort', { name: data.name, site: t('site.name') }),
  data.name,
].filter(Boolean);
// Sista kandidaten är bara namnet och släpps igenom även om det i sig är långt
// — alternativet vore en tom titel.
const title = titleCandidates.find((candidate) => candidate.length <= 60) ?? titleCandidates.at(-1)!;
// P2a (GSC-analys 2026-08-09): utan bio fick alla profiler samma generiska
// beskrivning. Har studion tyylit i datan skriver vi i stället ut dem plus
// artistmängden — den överblick som studions egen träff inte ger i SERPen.
const metaStyleNames = styleNames.map((name) => name.toLowerCase());
const artistCountSentence =
  allStudioArtists.length === 1
    ? t('artist.artistCount.one')
    : allStudioArtists.length > 1
      ? t('artist.artistCount.many', { n: allStudioArtists.length })
      : '';
const description = bio
  ? bio.length > 155
    ? `${bio.slice(0, 152)}…`
    : bio
  : metaStyleNames.length > 0
    ? t('artist.metaDescriptionData', {
        name: data.name,
        place: displayPlace,
        styles: metaStyleNames.join(', '),
        artists: artistCountSentence,
      })
    : t('artist.metaDescriptionFallback', {
        name: data.name,
        place: displayPlace,
        site: t('site.name'),
      });

const breadcrumbItems = [{ name: t('breadcrumb.home'), url: new URL(p('/'), site).href }];
if (city && h1City) {
  breadcrumbItems.push({
    name: t('city.h1', { city: h1City }),
    url: new URL(p(cityPath(city, locale)), site).href,
  });
}
breadcrumbItems.push({ name: data.name, url: new URL(p(path), site).href });
const breadcrumb = breadcrumbLd(breadcrumbItems);
const parlor = tattooParlorLd(studio, displayPlace, new URL(p(path), site).href);
// GEO.md §3 — Person per namngiven artist på studion (ingen egen sida ännu,
// se innehållsmodellen; mainEntityOfPage pekar tillbaka hit).
const pageUrl = new URL(p(path), site).href;
const personEntries = persons.map((person) =>
  personLd(person.data.name, data.name, pageUrl, person.data.instagram),
);
---

<BaseLayout title={title} description={description} locale={locale} path={path} hasAlternate>
  <script type="application/ld+json" set:html={jsonLdString(breadcrumb)} slot="head" />
  <script type="application/ld+json" set:html={jsonLdString(parlor)} slot="head" />
  {personEntries.map((person) => (
    <script type="application/ld+json" set:html={jsonLdString(person)} slot="head" />
  ))}

  <!-- Mörk identitets-hero -->
  <section class="artist-hero">
    <div class="container artist-hero-inner">
      {
        city && h1City ? (
          <a class="back-link ink-link" href={p(cityPath(city, locale))}>
            ← {t('city.h1', { city: h1City })}
          </a>
        ) : (
          <a class="back-link ink-link" href={p(citiesIndexPath(locale))}>← {t('nav.cities')}</a>
        )
      }
      {
        featured && (
          <p class="badge-row">
            <span class="badge-featured">★ {t('card.featured')}</span>
          </p>
        )
      }
      <div class="artist-ident">
        {/* Mockupens runda avatar bredvid namnet. Studios har inga egna
            porträtt (Bildpolicyn) — monogramplattan är sajtens egna yta
            och fungerar som identitetsmarkör utan att låtsas vara ett foto. */}
        <span class="artist-avatar" aria-hidden="true">
          <MonogramPlate name={data.name} featured={featured} />
        </span>
        <span class="artist-ident-text">
          <h1 class="artist-name">{data.name}</h1>
          {placeLine && <p class="artist-place">{placeLine}</p>}
        </span>
      </div>
      {
        styleNames.length > 0 && (
          <p class="artist-chips">
            {styleNames.map((styleName) => (
              <span class="chip chip--dark">{styleName}</span>
            ))}
          </p>
        )
      }
    </div>
  </section>

  <!-- Ark: kontaktkort över skarven, portfolio, info -->
  <div class="sheet grain">
    <div class="container layout">
      <aside class="side">
        {
          /* Kontaktkortet renderas bara när det finns riktiga länkar —
             en död CTA ser trasig ut. Utan kontakt flyter trust-kortet
             över skarven i stället. */
          hasContact && (
            <div class="contact-card">
              {bookingHref && (
                <a class="btn-cta" href={bookingHref} target="_blank" rel="noopener noreferrer">
                  {t('artist.book')}
                </a>
              )}
              {phoneHref && (
                <a class="btn-outline contact-phone" href={phoneHref}>
                  {t('artist.call')} · {data.phone}
                </a>
              )}
              {instagramUrl && (
                <a class="btn-outline" href={instagramUrl} target="_blank" rel="noopener noreferrer">
                  Instagram · @{data.instagram}
                </a>
              )}
              {paid && data.hours && (
                <p class="contact-hours">
                  <span class="contact-hours-label">{t('artist.hours')}</span>
                  {data.hours}
                </p>
              )}
              {
                /* Cookiefri Netlify-kontaktknapp (matris: Pro/Premium). Formuläret
                   detekteras vid build via data-netlify; honeypot mot spam, ingen
                   reCAPTCHA/cookie. Fältet `studio` skiljer inläggen åt. */
                paid && (
                  <details class="contact-form-toggle">
                    <summary class="btn-outline contact-form-summary">
                      {t('artist.contact.cta')}
                    </summary>
                    <form
                      class="contact-form"
                      name="yhteydenotto"
                      method="POST"
                      data-netlify="true"
                      netlify-honeypot="bot-field"
                      action={p(path)}
                    >
                      <input type="hidden" name="form-name" value="yhteydenotto" />
                      <input type="hidden" name="studio" value={data.name} />
                      <p class="hp" aria-hidden="true">
                        <label>Bot field <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
                      </p>
                      <label class="cf-label" for="cf-name">{t('artist.contact.name')}</label>
                      <input id="cf-name" name="nimi" type="text" required autocomplete="name" />
                      <label class="cf-label" for="cf-email">{t('artist.contact.email')}</label>
                      <input id="cf-email" name="sahkoposti" type="email" required autocomplete="email" />
                      <label class="cf-label" for="cf-msg">{t('artist.contact.message')}</label>
                      <textarea id="cf-msg" name="viesti" rows="3" required />
                      <button class="btn-cta cf-submit" type="submit">{t('artist.contact.submit')}</button>
                    </form>
                  </details>
                )
              }
              <p class="contact-note">{t('artist.responds')}</p>
            </div>
          )
        }

        <div class:list={['trust-card', { 'trust-card--float': !hasContact }]}>
          <h2 class="trust-title">{t('artist.trust')}</h2>
          {
            verified && (
              <p class="trust-row">
                <span class="trust-check" aria-hidden="true">✓</span>
                {t('artist.verified')}
              </p>
            )
          }
          {
            data.ftaaMember && (
              <p class="trust-row">
                <span class="trust-check" aria-hidden="true">✓</span>
                {t('artist.ftaa')}
              </p>
            )
          }
          {
            data.walkIn && (
              <p class="trust-row">
                <span class="trust-check" aria-hidden="true">✓</span>
                {t('artist.walkin')}
              </p>
            )
          }
          {
            data.website && (
              <p class="trust-row">
                <span class="trust-check" aria-hidden="true">✓</span>
                <a class="ink-link" href={data.website} target="_blank" rel="noopener noreferrer">{t('artist.website')}</a>
              </p>
            )
          }
          <div class="trust-studio">
            <span class="trust-studio-name">{data.name}</span>
            <span class="trust-studio-address">
              {data.address ? data.address : displayPlace}
            </span>
            {
              mapHref && (
                <a
                  class="trust-map ink-link"
                  href={mapHref}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="trust-map-pin" aria-hidden="true">◈</span>
                  {t('artist.map')}
                </a>
              )
            }
          </div>
        </div>

        {
          /* Diskret claim-loop på gratisprofiler (matris): leder till /hinnasto. */
          !paid && (
            <a class="claim-cta" href={p('/hinnasto/')}>
              <span class="claim-q">{claim.question}</span>
              <span class="claim-unlock">{claim.unlock}</span>
              {/* Subtila gråtonade "låsta" platser — diskret upsell, stör
                  inte kundvyn. Hinta-alue väntar på kommande schema-fält. */}
              <span class="claim-locks">
                {claim.locks.map((lock) => (
                  <span class="claim-lock">
                    <span class="claim-lock-icon" aria-hidden="true">🔒</span>
                    {lock}
                  </span>
                ))}
              </span>
              <span class="claim-link">{claim.cta} →</span>
            </a>
          )
        }

        <p class="freshness">{t('common.updated', { date: CONTENT_UPDATED })}</p>
      </aside>

      <div class="main-col">
        <!-- Sammanfattning. Står först i arket: den som kommit hit från en
             sökning på studions namn ska direkt se vad sidan tillför utöver
             studions egna kanaler. -->
        <section class="summary" aria-labelledby="summary-title">
          <h2 class="visually-hidden" id="summary-title">{t('artist.summaryTitle')}</h2>
          <p class="summary-text">{summarySentences.join(' ')}</p>
        </section>

        <!-- Portfolio: kärnan -->
        <section class="portfolio" aria-labelledby="portfolio-title">
          <div class="portfolio-head">
            <h2 class="portfolio-title" id="portfolio-title">{t('artist.portfolio')}</h2>
            {
              displayWorksCount > 0 && (
                <span class="portfolio-count">
                  {displayWorksCount === 1
                    ? t('artist.works.one')
                    : t('artist.works.many', { n: displayWorksCount })}
                </span>
              )
            }
          </div>
          {
            worksCount > 0 ? (
              <div class="portfolio-grid">
                {data.images.map((image, index) => (
                  <div
                    class="portfolio-item"
                    style={index === 0 ? `view-transition-name: artist-image-${studio.id};` : undefined}
                  >
                    <img src={image} alt={`${data.name} — ${index + 1}`} loading={index < 2 ? 'eager' : 'lazy'} />
                  </div>
                ))}
              </div>
            ) : embedPosts.length > 0 ? (
              <div class="portfolio-embeds">
                {embedPosts.map((url, index) => (
                  <div
                    class="portfolio-item"
                    style={index === 0 ? `view-transition-name: artist-image-${studio.id};` : undefined}
                  >
                    <InstagramEmbed url={url} name={data.name} locale={locale} />
                  </div>
                ))}
              </div>
            ) : (
              <div class="portfolio-empty">
                <div class="portfolio-plate" style={`view-transition-name: artist-image-${studio.id};`}>
                  <MonogramPlate name={data.name} featured={featured} />
                </div>
                <div class="portfolio-empty-info">
                  <h3 class="portfolio-empty-title">{t('artist.noImages.title')}</h3>
                  <p class="portfolio-empty-text">{t('artist.noImages.text')}</p>
                  {
                    instagramUrl && (
                      <a class="btn-outline portfolio-empty-cta" href={instagramUrl} target="_blank" rel="noopener noreferrer">
                        {t('artist.igCtaStudio', { name: data.name })}
                      </a>
                    )
                  }
                </div>
              </div>
            )
          }
        </section>

        <!-- Tietoa -->
        {
          bio && (
            <section class="about" aria-labelledby="about-title">
              <h2 class="about-title" id="about-title">{t('artist.about')}</h2>
              <p class="about-text">{bio}</p>
            </section>
          )
        }

        <!-- Artisterna på studion, med personliga IG-länkar -->
        {
          hasArtistsSection && (
            <section class="about" aria-labelledby="artists-title">
              <h2 class="about-title" id="artists-title">{t('artist.artists')}</h2>
              <p class="studio-artists">
                {persons.map((person) =>
                  person.data.instagram ? (
                    <a class="chip" href={igUrl(person.data.instagram)} target="_blank" rel="noopener noreferrer">
                      {person.data.name}
                      <span class="chip-ig" aria-hidden="true">↗</span>
                    </a>
                  ) : (
                    <span class="chip">{person.data.name}</span>
                  ),
                )}
                {extraHandles.map((handle) => (
                  <a class="chip" href={igUrl(handle)} target="_blank" rel="noopener noreferrer">
                    @{handle}
                    <span class="chip-ig" aria-hidden="true">↗</span>
                  </a>
                ))}
              </p>
            </section>
          )
        }

        <!-- Stilarna förklarade, var och en länkad vidare. Det här är den enda
             ytan på sidan som studions egna kanaler inte kan erbjuda: vem mer
             som gör samma stil på samma ort. -->
        {
          styleDetails.length > 0 && (
            <section class="about" aria-labelledby="styles-title">
              <h2 class="about-title" id="styles-title">
                {t('artist.stylesTitle', { name: data.name })}
              </h2>
              <ul class="style-list">
                {styleDetails.map((detail) => (
                  <li class="style-item">
                    <a class="style-item-name ink-link" href={p(styleLinkFor(detail.id))}>
                      {detail.name}
                    </a>
                    {detail.intro && <p class="style-item-text">{detail.intro}</p>}
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <!-- Andra studios i samma stad. Rubriken använder h1City, inte
             cityName: finskan kräver lokativ ("Muut tatuointiliikkeet
             Helsingissä"), och nominativ läser som en rubrik med ett
             påklistrat ortnamn. På svenska är de två identiska. -->
        {
          cityNeighbours.length > 0 && city && cityName && (
            <section class="about" aria-labelledby="nearby-title">
              <h2 class="about-title" id="nearby-title">
                {t('artist.nearbyTitle', { city: h1City })}
              </h2>
              <ul class="nearby-list">
                {cityNeighbours.map((neighbour) => (
                  <li>
                    <a class="nearby-link" href={p(`/artistit/${neighbour.id}/`)}>
                      <span class="nearby-name">{neighbour.data.name}</span>
                      {neighbour.data.district && (
                        <span class="nearby-place">{neighbour.data.district}</span>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
              <p class="nearby-all">
                <a class="ink-link" href={p(cityPath(city, locale))}>
                  {t('artist.nearbyAll', { city: h1City })} →
                </a>
              </p>
            </section>
          )
        }

        <!-- Guidelänkar. Den som söker på en studios namn har ofta inte bokat
             än, och de här tre frågorna kommer före bokningen. -->
        <section class="about" aria-labelledby="guides-title">
          <h2 class="about-title" id="guides-title">{t('artist.guidesTitle')}</h2>
          <ul class="guide-link-list">
            <li><a class="ink-link" href={p('/hinnat/')}>{t('artist.guidePrices')} →</a></li>
            {profileGuides.map((entry) => (
              <li>
                <a class="ink-link" href={p(guidePath(entry.route, locale))}>
                  {entry.label} →
                </a>
              </li>
            ))}
            <li>
              <a class="ink-link" href={p(guidesIndexPath(locale))}>
                {t('artist.guideAll')} →
              </a>
            </li>
          </ul>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

