---
/** Hem (wireframe 2b mobil / 3c desktop) — delad mellan fi (/) och sv (/sv/). */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SearchForm from '../SearchForm.astro';
import ArtistCard from '../ArtistCard.astro';
import Logo from '../Logo.astro';
import { styleImages } from '../../lib/styleImages';
import heroTatuoija from '../../assets/bilder/hero-tatuoija.png';
// Egna/licensierade brand-/miljöbilder för Premium-exempelkorten (Bildpolicy
// §4 — studiomiljö/porträtt, aldrig en listad artists verk).
import studioVaalea from '../../assets/bilder/studio-vaalea.png';
import tatuoijaStudiossa from '../../assets/bilder/tatuoija-studiossa.png';
import tatuoijaMuotokuva from '../../assets/bilder/tatuoija-muotokuva.png';
// Bakgrund till premium-säljbannern. Sajtens mörkaste bild (medelluminans 17
// av 255) — bannern behöver en yta som bär vit rubrik utan att slöjan måste
// vara så tät att fotot försvinner. Samma fil som Realismi-plattan i
// stilbandet, men beskuren till höger kant och nedtonad, så den läser som
// textur här och som motiv där.
import premiumTausta from '../../assets/bilder/enkeli-realismi.png';
import { useTranslations, localePath, type Locale } from '../../i18n/ui';
import {
  getCitiesSorted,
  getStylesSorted,
  getStudios,
  sortStudios,
  isFeatured,
  isVerified,
  isWalkIn,
  studioCountByCity,
  studioCountByStyle,
  cityDisplayName,
  styleDisplayName,
} from '../../lib/content';
import { jsonLdString, webSiteLd } from '../../lib/schema';
import { citiesIndexPath, cityPath } from '../../lib/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const p = (path: string) => localePath(locale, path);

const cities = await getCitiesSorted();
const styles = await getStylesSorted();
const studios = await getStudios();
const counts = await studioCountByCity();
const styleCounts = await studioCountByStyle();

const cityById = new Map(cities.map((city) => [city.id, city]));
const styleById = new Map(styles.map((style) => [style.id, style]));

// Endast Premium får hero-collage-platsen (matris: den enda knappa resursen).
// Tre platser: riktiga premiumstudios fyller framifrån, resten blir "ledig
// plats"-säljkort. Degraderar för 0/1/2/3 premium (aldrig trasiga tomrutor).
const featured = sortStudios(studios.filter(isFeatured)).slice(0, 3);
const featuredSlots = Array.from({ length: 3 }, (_, i) => featured[i] ?? null);
// Riktiga, klickbara studiokort högst upp — verifierade studios (ärligt
// urval, ingen låtsas-popularitet, aldrig implicerad premium). Tom = sektionen
// döljs. isVerified = verified-flaggan (+ ev. betald nivå senare).
const popular = sortStudios(studios.filter(isVerified)).slice(0, 6);
// Premium-exempelkort (visas när 0 betalande premium finns): demonstrerar
// för B2B hur en Premium-listning ser ut på etusivun. TYDLIGT märkta
// "Esimerkki" med placeholder-innehåll ("Studiosi tässä") — inga fejkade
// riktiga studios, ingen profil/schema, länkar till /hinnasto. Bilderna är
// våra egna brand-/miljöbilder (Bildpolicy §4).
const premiumExamples = [
  { image: studioVaalea, style: 'realismi' },
  { image: tatuoijaStudiossa, style: 'fineline' },
  { image: tatuoijaMuotokuva, style: 'blackwork' },
].map(({ image, style }) => {
  const s = styleById.get(style);
  return { image, styleName: s ? styleDisplayName(s, locale) : style };
});
// Störst först — griden visar topp 6, resten nås via "Kaikki →"
const citiesByCount = [...cities].sort(
  (a, b) =>
    (counts.get(b.id) ?? 0) - (counts.get(a.id) ?? 0) ||
    cityDisplayName(a, locale).localeCompare(cityDisplayName(b, locale), locale),
);
const topCities = citiesByCount.slice(0, 6);
const popularCities = citiesByCount.slice(0, 3);

function studioMeta(studio: (typeof studios)[number]): string {
  const city = studio.data.city ? cityById.get(studio.data.city) : undefined;
  const place = city ? cityDisplayName(city, locale) : (studio.data.place ?? '');
  return [studio.data.district, place].filter(Boolean).join(', ');
}
function studioStyleNames(studio: (typeof studios)[number]): string[] {
  return studio.data.styles.map((slug) => {
    const style = styleById.get(slug);
    return style ? styleDisplayName(style, locale) : slug;
  });
}

// Bläck-gradienter i olika valörer (#1e1e1e → #3a2a2e-spannet, lyft för mörk bas 10/8 2026).
// Byts mot egna/licensierade miljöbilder senare (Bildpolicy §4).
const ink = (angle: number, from: string, to: string, mid?: string) =>
  mid
    ? `linear-gradient(${angle}deg, ${from} 0%, ${mid} 55%, ${to} 100%)`
    : `linear-gradient(${angle}deg, ${from} 0%, ${to} 100%)`;

// Fallback-gradienter för stilar utan foto i styleImages
const styleGradients = [
  ink(160, '#1e1e1e', '#2d2430'),
  ink(200, '#222222', '#33272c'),
  ink(150, '#1a1a1a', '#2a2126'),
  ink(215, '#242424', '#3a2a2e'),
  ink(170, '#202020', '#35272b'),
  ink(190, '#1e1e1e', '#2c2328'),
];

// Domän = brand: "Tatuoijat.fi — Suomen tatuoijat ja tatuointiliikkeet"
// ger naturlig exakt träff på "tatuoijat"-sökningar (handoff §7).
const title = `${t('site.name')} — ${t('home.metaSuffix')}`;

// WebSite-entiteten pekar alltid på sajtroten, oavsett locale.
// SearchAction pekar sedan 2026-08-10 på den riktiga fritextsökningen
// (/haku/?q=). Tidigare pekade den på ?tyyli= — en select-parameter som
// bara accepterade tio fasta slugs, alltså inte en sökning alls.
const site = Astro.site!;
const webSite = webSiteLd(
  t('site.name'),
  site.href,
  `${new URL('/haku/', site).href}?q={search_term_string}`,
);
---

<BaseLayout title={title} description={t('home.metaDescription')} locale={locale} path="/" hasAlternate>
  <script type="application/ld+json" set:html={jsonLdString(webSite)} slot="head" />
  <!-- ================= HERO: fullbredds-bild, sticky bakom arket ================= -->
  <section class="hero">
    <div class="hero-media" aria-hidden="true">
      <Image
        src={heroTatuoija}
        alt=""
        widths={[640, 1024, 1440, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="container hero-inner">
      <h1 class="hero-title"><Logo locale={locale} size="hero" /></h1>
      <p class="hero-tagline">{t('site.description')}</p>
      <a class="btn-cta hero-cta" href={p('/hinnasto/')}>{t('home.premiumCta.title')}</a>
    </div>
  </section>

  <!-- ================= BENVIT "ARK" — glider över heron =================
       10/8 2026: arket är LJUST igen (klassen `reading`). Startsidan låg helt
       på #0d0d0d och blev en enda svart massa — bandindelningen räckte inte.
       Nu bär mörkret bara där bilden bär: hero i toppen, stilgalleriet som
       mörkt band i mitten, "Näin se toimii" som mörk fot. Allt däremellan
       ligger på benvitt, precis som guiderna och /hinnasto redan gör. -->
  <div class="sheet grain reading">
    <div class="container sheet-inner">
      <!-- Flytande sökkort ÖVER skarven — halva på mörkt, halva på ljust -->
      <div class="float-search" id="haku">
        <SearchForm
          locale={locale}
          cities={cities}
          styles={styles}
          idPrefix="hm"
          popularCities={popularCities}
          withQuery
        />
      </div>

      <!-- PREMIUMPLATSEN — alltid först efter sökningen. Premiumets hela
           värde ÄR topplaceringen: när betalande premium finns fyller de
           guld-raden här (+ knapphet i lediga slots); annars visas EN ärlig
           säljbanner som lovar toppplatsen — aldrig tomma fejkkort. Så syns
           premium alltid först utan att platsen fejkas dag 1. -->
      {
        featured.length > 0 ? (
          <section class="section" aria-labelledby="featured-title">
            <div class="section-head">
              <div>
                <p class="eyebrow">{t('home.featured.eyebrow')}</p>
                <h2 class="section-title" id="featured-title">{t('home.featured.title')}</h2>
              </div>
              <a class="ink-link section-all" href={p(citiesIndexPath(locale))}>{t('home.all')} →</a>
            </div>
            <div class="featured-grid reveal-stagger">
              {featuredSlots.map((studio) =>
                studio ? (
                  <ArtistCard
                    slug={studio.id}
                    name={studio.data.name}
                    meta={studioMeta(studio)}
                    styleNames={studioStyleNames(studio)}
                    premium={isFeatured(studio)}
                    size="featured"
                    locale={locale}
                  />
                ) : (
                  <a class="premium-slot" href={p('/hinnasto/')}>
                    <span class="premium-slot-badge">{t('home.featured.slotBadge')}</span>
                    <span class="premium-slot-title">{t('home.featured.slotTitle')}</span>
                    <span class="premium-slot-text">{t('home.featured.slotText')}</span>
                    <span class="premium-slot-cta">{t('home.featured.slotCta')} →</span>
                  </a>
                ),
              )}
            </div>
          </section>
        ) : (
          <section class="section" aria-labelledby="premium-demo-title">
            <div class="section-head">
              <div>
                <p class="eyebrow">{t('home.featured.eyebrow')}</p>
                <h2 class="section-title" id="premium-demo-title">{t('home.premiumExample.heading')}</h2>
              </div>
            </div>
            <div class="featured-grid reveal-stagger">
              {premiumExamples.map((ex) => (
                <a class="premium-example" href={p('/hinnasto/')}>
                  <div class="pe-media">
                    <Image
                      src={ex.image}
                      alt=""
                      widths={[400, 800]}
                      sizes="(min-width: 1024px) 33vw, 100vw"
                      loading="lazy"
                    />
                    <span class="badge-featured pe-badge">★ {t('card.featured')}</span>
                    <span class="pe-tag">{t('home.premiumExample.tag')}</span>
                  </div>
                  <div class="pe-body">
                    <span class="pe-name">{t('home.premiumExample.name')}</span>
                    <span class="pe-meta">{t('home.premiumExample.place')}</span>
                    <span class="pe-chips">
                      <span class="pe-chip">{ex.styleName}</span>
                    </span>
                  </div>
                </a>
              ))}
            </div>
            <!-- Säljbanner under exemplen: knapphet + tydlig CTA -->
            <a class="premium-cta" href={p('/hinnasto/')}>
              <Image
                class="premium-cta-bg"
                src={premiumTausta}
                alt=""
                widths={[720, 1200, 1600]}
                sizes="(min-width: 1024px) 1200px, 100vw"
                loading="lazy"
              />
              <span class="premium-cta-veil" aria-hidden="true" />
              <div class="premium-cta-copy">
                <span class="badge-featured">★ {t('card.featured')}</span>
                <h3 class="premium-cta-title">{t('home.premiumCta.title')}</h3>
                <p class="premium-cta-text">{t('home.premiumCta.text')}</p>
              </div>
              <span class="btn-cta premium-cta-btn">{t('home.premiumCta.button')}</span>
            </a>
          </section>
        )
      }

      <!-- Tutustu studioihin — riktiga, klickbara studiokort direkt under
           premiumplatsen så förstagångsbesökaren genast har äkta innehåll
           (verifierade studios, ärligt urval). B2C-motorn på sidan. Döljs
           om inga verifierade finns. -->
      {
        popular.length > 0 && (
          <section class="section" aria-labelledby="popular-title">
            <div class="section-head">
              <div>
                <p class="eyebrow">{t('home.popular.eyebrow')}</p>
                <h2 class="section-title" id="popular-title">{t('home.popular.title')}</h2>
              </div>
              <a class="ink-link section-all" href={p(citiesIndexPath(locale))}>{t('home.all')} →</a>
            </div>
            <div class="popular-grid reveal-stagger">
              {popular.map((studio) => (
                <ArtistCard
                  slug={studio.id}
                  name={studio.data.name}
                  meta={studioMeta(studio)}
                  styleNames={studioStyleNames(studio)}
                  walkIn={isWalkIn(studio)}
                  size="compact"
                  locale={locale}
                />
              ))}
            </div>
          </section>
        )
      }

      <!-- Selaa tyylin mukaan — sajtens visuella centrum, extra luft -->
      <section class="section section--styles inked" aria-labelledby="styles-title">
        <div class="section-head">
          <div>
            <p class="eyebrow">{t('home.styles.eyebrow')}</p>
            <h2 class="section-title" id="styles-title">{t('home.styles.title')}</h2>
          </div>
          <!-- Pilar för pekdon. Raden har alltid gått att dra på touch, men med
               mus fanns ingen synlig väg vidare (scrollbaren är dold). Renderas
               dolda och slås på av skriptet nedan — utan JS skulle de inte göra
               något, och då ska de inte synas. "Kaikki" ligger bredvid som den
               JS-fria vägen till hela stillistan. -->
          <div class="rail-aside">
          <a class="ink-link section-all styles-all" href={p('/tyylit/')}>{t('home.all')} →</a>
          <div class="rail-nav" hidden data-rail-nav>
            <button class="rail-btn" type="button" data-rail-prev aria-label={t('home.styles.prev')}>
              <span aria-hidden="true">←</span>
            </button>
            <button class="rail-btn" type="button" data-rail-next aria-label={t('home.styles.next')}>
              <span aria-hidden="true">→</span>
            </button>
          </div>
          </div>
        </div>
        <div class="style-rail">
        <div class="style-strip reveal-stagger" data-style-strip>
          {
            styles.map((style, index) => (
              <a class="style-card" href={p(`/tyylit/${style.id}/`)}>
                {styleImages[style.id] ? (
                  <Image
                    class="style-photo"
                    src={styleImages[style.id]!}
                    alt=""
                    widths={[400, 800]}
                    sizes="(min-width: 1024px) 320px, 62vw"
                    loading="lazy"
                  />
                ) : (
                  <span
                    class="style-bg grain-dark"
                    style={`background:${styleGradients[index % styleGradients.length]}`}
                    aria-hidden="true"
                  />
                )}
                {/* Slöjan ligger i markup, inte som ::after, så den kan skalas
                    med korthöjden — foton som Blackwork är nästan svarta i
                    botten och behöver en djupare fot än ljusa som Fineline. */}
                <span class="style-veil" aria-hidden="true" />
                <span class="style-foot">
                  <span class="style-text">
                    <span class="style-name">{styleDisplayName(style, locale)}</span>
                    {(styleCounts.get(style.id) ?? 0) > 0 && (
                      <span class="style-count">
                        {t('home.artistCount.many', { n: styleCounts.get(style.id) ?? 0 })}
                      </span>
                    )}
                  </span>
                  <span class="style-go" aria-hidden="true">→</span>
                </span>
              </a>
            ))
          }
        </div>
        </div>
      </section>

      <!-- Selaa kaupungin mukaan -->
      <section class="section section--last" aria-labelledby="cities-title">
        <div class="section-head">
          <div>
            <p class="eyebrow">{t('home.cities.eyebrow')}</p>
            <h2 class="section-title" id="cities-title">{t('home.cities.title')}</h2>
          </div>
          <a class="ink-link section-all" href={p(citiesIndexPath(locale))}>{t('home.all')} →</a>
        </div>
        <div class="city-grid reveal-stagger">
          {
            topCities.map((city) => {
              const count = counts.get(city.id) ?? 0;
              return (
                <a class="city-card" href={p(cityPath(city, locale))}>
                  <span class="city-info">
                    <span class="city-name">
                      {cityDisplayName(city, locale)}
                      <span class="city-arrow" aria-hidden="true">→</span>
                    </span>
                  </span>
                  {count > 0 && (
                    <span class="city-count">
                      <span class="city-num" aria-hidden="true">{count}</span>
                      <span class="city-num-label">
                        {count === 1
                          ? t('home.artistCount.one').replace(/^1\s*/, '')
                          : t('home.artistCount.many', { n: '' }).trim()}
                      </span>
                      <span class="visually-hidden">
                        {count === 1
                          ? t('home.artistCount.one')
                          : t('home.artistCount.many', { n: count })}
                      </span>
                    </span>
                  )}
                </a>
              );
            })
          }
        </div>
      </section>
    </div>
  </div>

  <!-- ================= NÄIN SE TOIMII (bläcksvart) ================= -->
  <section class="how" aria-labelledby="how-title">
    <div class="container how-inner">
      <p class="eyebrow">{t('how.eyebrow')}</p>
      <h2 class="section-title how-title" id="how-title">{t('how.title')}</h2>
      <div class="how-steps">
        {
          (['step1', 'step2', 'step3'] as const).map((step, index) => (
            <div class="how-step">
              <span class="how-number" aria-hidden="true">{`0${index + 1}`}</span>
              <div>
                <h3 class="how-step-title">{t(`how.${step}.title`)}</h3>
                <p class="how-step-text">{t(`how.${step}.text`)}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<!-- IntersectionObserver-fallback för hero-scrubben i webbläsare utan
     CSS scroll-driven animations (CLAUDE.md, Motion). -->
<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!CSS.supports('animation-timeline: scroll()') && !reduceMotion) {
    const hero = document.querySelector('.hero');
    const media = document.querySelector('.hero-media');
    if (hero && media) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          media.classList.toggle('is-scrolled', (entry?.intersectionRatio ?? 1) < 0.55);
        },
        { threshold: [0.55] },
      );
      observer.observe(hero);
    }
  }

  // Tyyliraidan pilar (vain osoitinlaitteilla — kosketuksella raitaa vedetään).
  // Askel = yhden kortin leveys + gap, luettuna layoutista, jotta se seuraa
  // mediakyselyiden kortti- ja gap-kokoja ilman kovakoodattuja pikseleitä.
  const strip = document.querySelector('[data-style-strip]');
  const railNav = document.querySelector('[data-rail-nav]');
  const railPrev = document.querySelector('[data-rail-prev]');
  const railNext = document.querySelector('[data-rail-next]');
  if (
    strip instanceof HTMLElement &&
    railNav instanceof HTMLElement &&
    railPrev instanceof HTMLButtonElement &&
    railNext instanceof HTMLButtonElement
  ) {
    const step = () => {
      const card = strip.querySelector('.style-card');
      if (!(card instanceof HTMLElement)) return strip.clientWidth * 0.8;
      const styles = getComputedStyle(strip);
      const gap = parseFloat(styles.columnGap || styles.gap || '0') || 0;
      return card.getBoundingClientRect().width + gap;
    };
    const rail = strip.parentElement;
    const update = () => {
      const max = strip.scrollWidth - strip.clientWidth;
      // Ingen overflow (t.ex. mycket bred skärm) → dölj hela kontrollen.
      railNav.hidden = max <= 4;
      railPrev.disabled = strip.scrollLeft <= 2;
      railNext.disabled = strip.scrollLeft >= max - 2;
      // Kantfaden mot bandets högerkant syns bara så länge det finns mer att
      // scrolla; annars ser den ut som ett fel på det sista kortet.
      if (rail) rail.toggleAttribute('data-more', !railNext.disabled);
    };
    const nudge = (dir: number) => {
      strip.scrollBy({
        left: dir * step(),
        behavior: reduceMotion ? 'auto' : 'smooth',
      });
    };
    railPrev.addEventListener('click', () => nudge(-1));
    railNext.addEventListener('click', () => nudge(1));
    strip.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>

<style>
  /* SEKTIONSRYTM (Calle 10/8: "gillar fortfarande inte startsidan, den ar
     for mork"). Forsta forsoket lyfte varannan sektion fran #0d0d0d till
     #1a1a1a — tva svarta som knappt gar att skilja at, sa sidan lastes
     fortfarande som en enda svart massa. Nu ar grundytan i stallet LJUS
     (arket har klassen `reading`) och mörkret anvands som accent:
       hero (foto)  ->  ljust ark  ->  mörkt stilband  ->  ljust  ->  mörk fot.
     Kontrasten mellan banden ar da 15:1 i stallet for 1.2:1. */

  /* ================= Hero: fullbredds-bild ================= */
  .hero {
    position: sticky;
    top: 0;
    z-index: 0;
    overflow: hidden;
    background: var(--ink);
  }
  .hero-media {
    position: absolute;
    inset: 0;
  }
  .hero-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 72% 40%; /* artisten till höger i bild */
    display: block;
    filter: saturate(0.9);
  }
  /* Skugglager så typografin alltid har kontrast: mörk vänsterkant +
     mjuk övergång mot arket i botten */
  .hero-shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(
        180deg,
        rgba(16, 16, 20, 0.25) 0%,
        rgba(16, 16, 20, 0.1) 40%,
        rgba(16, 16, 20, 0.72) 82%,
        #0d0d0d 100%
      ),
      linear-gradient(90deg, rgba(16, 16, 20, 0.7) 0%, rgba(16, 16, 20, 0.15) 55%, rgba(16, 16, 20, 0) 100%);
  }
  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    min-height: 470px;
    /* Extra bottompadding lyfter textblocket ovanför skarven mot arket
       och ger CTA-knappen luft att andas under taglinen. */
    padding: 0 var(--page-pad) 108px;
  }
  .hero-title {
    margin: 0;
  }
  .hero-tagline {
    margin: 16px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-light);
    opacity: 0.8;
    max-width: 320px;
  }
  .hero-cta {
    display: inline-block;
    width: auto;
    margin-top: 22px;
    padding: 13px 26px;
  }

  @media (min-width: 1024px) {
    .hero-inner {
      min-height: 640px;
      padding-bottom: 152px;
    }
    .hero-tagline {
      margin: 26px 0 0;
      font-size: 17px;
      line-height: 1.55;
      max-width: 460px;
    }
    .hero-cta {
      margin-top: 30px;
      padding: 15px 32px;
      font-size: 15px;
    }
  }

  /* Hero-scrub: bilden zoomar ut och tonar medan MUSTE-typografin sitter
     kvar. Native CSS scroll-driven animation; IO-fallback i <script> ovan. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-media {
      transform: scale(1.06);
      transform-origin: 50% 30%;
    }
    @supports (animation-timeline: scroll()) {
      .hero-media {
        animation: hero-scrub linear both;
        animation-timeline: scroll();
        animation-range: 0 560px;
      }
    }
    .hero-media.is-scrolled {
      transform: scale(1);
      opacity: 0.4;
      transition:
        transform 700ms var(--ease-out),
        opacity 700ms var(--ease-out);
    }
  }
  @keyframes hero-scrub {
    to {
      transform: scale(1);
      opacity: 0.35;
    }
  }

  /* ================= Arket ================= */
  .sheet {
    position: relative;
    z-index: 1;
    background: var(--paper);
    border-radius: var(--r-sheet) var(--r-sheet) 0 0;
    margin-top: var(--sheet-overlap);
  }
  .sheet-inner {
    padding: 0 16px 32px;
  }
  .float-search {
    position: relative;
    margin-top: -44px;
  }

  .section {
    margin-top: 34px;
    padding: 0 4px;
  }
  /* Mörkt fullbreddsband inuti det ljusa arket — sajtens visuella centrum.
     `.inked` (tokens.css) deklarerar om de semantiska färgerna, så rubrik,
     pilknappar och kort följer med utan en enda extra regel här. Negativ
     margin-inline motsvarar exakt .sheet-inner-paddingen + .section-paddingen,
     så bandet går kant i kant med arket. Måste ligga EFTER `.section` —
     samma specificitet, och padding skulle annars skrivas över. */
  .section--styles {
    position: relative;
    margin-top: 48px;
    margin-bottom: 48px;
    margin-inline: -20px; /* .sheet-inner 16px + .section 4px */
    padding: 30px 20px 34px;
    border-block: 1px solid rgba(13, 13, 13, 0.12);
    /* Svag vinröd glöd uppe till höger — annars blir bandet en platt svart
       rektangel. Radial i stället för linjär: en linjär gradient över hela
       bredden syns som en rand, en radial läses som ljus. */
    background-image: radial-gradient(
      120% 90% at 88% 0%,
      rgba(139, 30, 63, 0.22) 0%,
      rgba(13, 13, 13, 0) 62%
    );
  }
  /* Rälsen bär kantfaden. Den sitter INTE på .style-strip, eftersom en mask
     på ett scrollande element följer med innehållet i stället för att ligga
     still mot bandkanten. */
  .style-rail {
    position: relative;
  }
  .style-rail::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 8px;
    right: -20px; /* ut till bandets kant */
    width: 56px;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--t-med) var(--ease-out);
    background: linear-gradient(90deg, rgba(13, 13, 13, 0) 0%, rgba(13, 13, 13, 0.8) 66%, var(--paper) 100%);
  }
  /* Sätts av skriptet så länge det finns mer att scrolla — en fade som ligger
     kvar när raden tagit slut ser ut som en bugg, inte som en signal. */
  .style-rail[data-more]::after {
    opacity: 1;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 16px;
  }
  .section-all {
    font-size: 12px;
    font-weight: 600;
    color: var(--text);
  }

  /* Riktiga studiokort direkt under sökningen */
  .popular-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .featured-grid {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* "Ledig plats"-kort — en avsiktlig, premiumkänd annonsyta (mörkt brand-
     kort + guld-accent), INTE en trasig tom ruta. Samma yttermått som ett
     artistkort så griden håller formen oavsett hur många premium som finns. */
  .premium-slot {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 8px;
    min-height: 260px;
    background:
      radial-gradient(130% 120% at 85% 0%, rgba(201, 162, 39, 0.16) 0%, rgba(16, 16, 20, 0) 55%),
      var(--ink);
    border: 1px solid rgba(201, 162, 39, 0.28);
    border-radius: var(--r-card);
    padding: 20px;
    text-decoration: none;
    overflow: hidden;
    transition:
      transform var(--t-med) var(--ease-out),
      box-shadow var(--t-med) var(--ease-out),
      border-color var(--t-med) var(--ease-out);
  }
  .premium-slot:hover {
    transform: translateY(-4px);
    border-color: rgba(201, 162, 39, 0.55);
    box-shadow: 0 16px 32px rgba(16, 16, 20, 0.22);
  }
  .premium-slot-badge {
    align-self: flex-start;
    margin-bottom: auto;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
    border: 1px solid rgba(201, 162, 39, 0.5);
    border-radius: var(--r-chip);
    padding: 5px 10px;
  }
  .premium-slot-title {
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 1.1;
    color: var(--text-light);
  }
  .premium-slot-text {
    font-size: 12.5px;
    line-height: 1.5;
    /* Kortet är svart även på det ljusa arket — därför den bläckfasta
       varianten, inte --meta (som är mörkgrå i ljust läge). */
    color: var(--meta-on-ink);
    max-width: 22ch;
  }
  .premium-slot-cta {
    margin-top: 4px;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--gold);
    transition: transform var(--t-med) var(--ease-out);
  }
  .premium-slot:hover .premium-slot-cta {
    transform: translateX(3px);
  }
  @media (prefers-reduced-motion: reduce) {
    .premium-slot:hover {
      transform: none;
    }
    .premium-slot:hover .premium-slot-cta {
      transform: none;
    }
  }

  /* "Haluatko näkyä tässä?" — säljruta för nästa Premium-plats */
  .premium-cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 14px;
    background: var(--ink);
    border-radius: var(--r-card-lg);
    padding: 22px;
    text-decoration: none;
    transition:
      transform var(--t-med) var(--ease-out),
      box-shadow var(--t-med) var(--ease-out);
  }
  .premium-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 30px rgba(16, 16, 20, 0.2);
  }
  /* Fotot ligger som textur, inte som motiv: hård beskärning mot höger kant
     (object-position) + nedtoning, så det inte läser som en upprepning av
     Realismi-plattan längre ner. */
  .premium-cta-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Bannern är extremt bred och låg — beskärningen väljer i praktiken bara
       en vågrät remsa. 90 % tar den nedre delen: mörk hud och skugga, alltså
       textur. Mitten (38 %) landade på statyns ansikte, vilket läste som en
       kopia av Realismi-plattan i stilbandet. */
    object-position: 50% 90%;
    filter: saturate(0.5) brightness(0.62) contrast(1.06);
    transition: transform var(--t-med) var(--ease-out);
  }
  .premium-cta:hover .premium-cta-bg {
    transform: scale(1.03);
  }
  /* Slöjan är tätast där texten står. Guld-radialen är kvar överst — den är
     premiumplatsens enda färgmarkör och skulle annars drunkna i fotot. */
  .premium-cta-veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(120% 140% at 85% 0%, rgba(201, 162, 39, 0.14) 0%, rgba(16, 16, 20, 0) 55%),
      linear-gradient(
        180deg,
        rgba(13, 13, 13, 0.82) 0%,
        rgba(13, 13, 13, 0.88) 62%,
        rgba(13, 13, 13, 0.94) 100%
      );
  }
  @media (min-width: 640px) {
    /* På bredare ytor står texten till vänster och knappen till höger —
       då kan fotot andas i mitten och tona in mot båda kanterna. */
    .premium-cta-veil {
      background:
        radial-gradient(120% 140% at 85% 0%, rgba(201, 162, 39, 0.14) 0%, rgba(16, 16, 20, 0) 55%),
        linear-gradient(
          90deg,
          rgba(13, 13, 13, 0.95) 0%,
          rgba(13, 13, 13, 0.88) 38%,
          rgba(13, 13, 13, 0.6) 62%,
          rgba(13, 13, 13, 0.9) 100%
        );
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .premium-cta:hover .premium-cta-bg {
      transform: none;
    }
  }
  .premium-cta-title {
    font-size: 22px;
    color: var(--text-light);
    margin: 12px 0 0;
  }
  .premium-cta-text {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--meta-on-ink);
    margin: 8px 0 0;
    max-width: 420px;
  }
  .premium-cta-btn {
    width: auto;
    align-self: flex-start;
    padding: 13px 26px;
  }

  /* Premium-exempelkort (0 premium) — demonstrerar Premium-listningens
     utseende. Guldram + guld-badge sticker ut; "Esimerkki"-taggen håller
     det ärligt (ingen fejkad riktig studio). Samma anatomi som ArtistCard. */
  .premium-example {
    display: block;
    position: relative;
    background: var(--ink);
    border: 1px solid rgba(201, 162, 39, 0.35);
    border-radius: var(--r-card);
    overflow: hidden;
    text-decoration: none;
    transition:
      transform var(--t-med) var(--ease-out),
      box-shadow var(--t-med) var(--ease-out),
      border-color var(--t-med) var(--ease-out);
  }
  .premium-example:hover {
    transform: translateY(-4px);
    border-color: rgba(201, 162, 39, 0.6);
    box-shadow: 0 16px 32px rgba(16, 16, 20, 0.22);
  }
  .pe-media {
    position: relative;
    height: 190px;
    overflow: hidden;
  }
  .pe-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85) brightness(0.82);
    transition: transform var(--t-med) var(--ease-out);
  }
  .premium-example:hover .pe-media :global(img) {
    transform: scale(1.03);
  }
  .pe-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 1;
  }
  .pe-tag {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 1;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-light);
    background: rgba(16, 16, 20, 0.7);
    border: 1px solid rgba(237, 234, 226, 0.3);
    padding: 4px 9px;
    border-radius: var(--r-chip);
    backdrop-filter: blur(2px);
  }
  .pe-body {
    padding: 14px 16px 16px;
  }
  .pe-name {
    display: block;
    font-family: var(--font-display);
    font-size: 15px;
    color: var(--text-light);
  }
  .pe-meta {
    display: block;
    font-size: 12.5px;
    color: var(--meta-on-ink);
    margin: 3px 0 10px;
  }
  .pe-chips {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .pe-chip {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-light);
    border: 1px solid rgba(237, 234, 226, 0.25);
    border-radius: var(--r-chip);
    padding: 4px 10px;
  }
  @media (prefers-reduced-motion: reduce) {
    .premium-example:hover {
      transform: none;
    }
    .premium-example:hover .pe-media :global(img) {
      transform: none;
    }
  }

  /* Pilkontroll för stilraden — bara pekdon (hover: hover). På touch drar man
     raden direkt och knapparna vore bara i vägen. Ligger i section-head, inte
     som overlay över korten, eftersom raden bleeder ut till högerkanten. */
  .rail-aside {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .styles-all {
    white-space: nowrap;
  }
  .rail-nav {
    display: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .rail-nav:not([hidden]) {
      display: flex;
      gap: 8px;
      align-self: center;
    }
  }
  .rail-btn {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border: var(--card-border-strong);
    border-radius: 50%;
    background: var(--paper);
    color: var(--text);
    font-size: 15px;
    line-height: 1;
    cursor: pointer;
    transition:
      background var(--t-fast) var(--ease-out),
      color var(--t-fast) var(--ease-out),
      opacity var(--t-fast) var(--ease-out);
  }
  /* Vinröd hover i stället för "bläck" — knappen sitter numera i det mörka
     stilbandet, där bläck-på-bläck vore osynligt. */
  .rail-btn:hover:not(:disabled) {
    background: var(--flash);
    border-color: var(--flash);
    color: var(--text-on-flash, #fff);
  }
  .rail-btn:focus-visible {
    outline: 2px solid var(--flash);
    outline-offset: 2px;
  }
  .rail-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  /* Stilgalleriet: bläck-gradientplattor, horisontell scroll-snap med peek */
  .style-strip {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding: 0 0 8px;
    margin-right: -20px; /* bleed ut till bandets högerkant (band-padding 20px) */
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
  }
  .style-strip::-webkit-scrollbar {
    display: none;
  }
  /* Stilkortet: stående gallerimått i stället för de gamla liggande
     plattorna. Ett tatueringsmotiv sitter nästan alltid på en arm, en rygg
     eller ett ben — stående ram beskär det snällare, och raden får en
     tydligare rytm. */
  .style-card {
    flex: none;
    position: relative;
    width: 168px;
    height: 224px;
    border-radius: var(--r-card);
    overflow: hidden;
    scroll-snap-align: start;
    text-decoration: none;
    isolation: isolate;
    border: 1px solid rgba(242, 242, 242, 0.08);
    transition:
      border-color var(--t-med) var(--ease-out),
      transform var(--t-med) var(--ease-out);
  }
  .style-card:hover {
    transform: translateY(-3px);
    border-color: rgba(242, 242, 242, 0.22);
  }
  .style-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    transition: transform var(--t-med) var(--ease-out);
  }
  .style-card :global(.style-photo) {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* enhetlig ton över alla plattor */
    filter: saturate(0.8) contrast(0.98);
    transition: transform var(--t-med) var(--ease-out);
  }
  .style-card:hover :global(.style-photo) {
    transform: scale(1.04);
  }
  .style-card:hover .style-bg {
    transform: scale(1.04);
  }

  /* Slöjan gör foten läsbar oavsett foto. Två stopp i mitten i stället för
     ett: en rak gradient från 0 till 0.9 lägger halva sin täthet över
     bildens mitt och grumlar motivet, vilket är just det man vill se. */
  .style-veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(13, 13, 13, 0.1) 0%,
      rgba(13, 13, 13, 0) 34%,
      rgba(13, 13, 13, 0.42) 62%,
      rgba(13, 13, 13, 0.88) 100%
    );
  }

  .style-foot {
    position: absolute;
    inset: auto 12px 12px;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 8px;
  }
  .style-text {
    display: block;
    min-width: 0;
  }
  .style-name {
    position: relative;
    display: inline-block;
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: 18px;
    line-height: 1.1;
    color: #fff;
  }
  /* Vinröd understrykning som växer fram — samma bläck-gest som .ink-link
     använder i resten av sajten, så raden känns som en del av systemet. */
  .style-name::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -3px;
    height: 2px;
    background: var(--flash);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--t-med) var(--ease-out);
  }
  .style-card:hover .style-name::after {
    transform: scaleX(1);
  }
  .style-count {
    display: block;
    margin-top: 7px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(242, 242, 242, 0.66);
  }
  .style-go {
    flex: none;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid rgba(242, 242, 242, 0.32);
    color: #fff;
    font-size: 13px;
    line-height: 1;
    transition:
      background var(--t-med) var(--ease-out),
      border-color var(--t-med) var(--ease-out),
      transform var(--t-med) var(--ease-out);
  }
  .style-card:hover .style-go {
    background: var(--flash);
    border-color: var(--flash);
    transform: translateX(2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .style-card:hover {
      transform: none;
    }
    .style-card:hover .style-go {
      transform: none;
    }
  }

  /* Stads-kort: namn med bläck-underline, antal som stor siffra, glidande pil */
  .city-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .city-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    background: var(--surface);
    border: var(--card-border-strong);
    border-radius: var(--r-card);
    padding: 16px;
    text-decoration: none;
    transition:
      transform var(--t-med) var(--ease-out),
      box-shadow var(--t-med) var(--ease-out);
  }
  .city-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(16, 16, 20, 0.12);
  }
  .city-name {
    position: relative;
    display: inline-block;
    font-family: var(--font-display);
    font-size: 15px;
    color: var(--text);
  }
  .city-name::after {
    /* bläck-underline som "blöder" ut från vänster (effekt-demon) */
    content: '';
    position: absolute;
    left: 0;
    right: 16px;
    bottom: -3px;
    height: 2px;
    background: var(--text);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--t-med) var(--ease-out);
  }
  .city-card:hover .city-name::after {
    transform: scaleX(1);
  }
  .city-arrow {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 13px;
    margin-left: 6px;
    opacity: 0;
    transform: translateX(-6px);
    transition:
      transform var(--t-med) var(--ease-out),
      opacity var(--t-med) var(--ease-out);
  }
  .city-card:hover .city-arrow {
    opacity: 1;
    transform: translateX(0);
  }
  .city-count {
    text-align: right;
    line-height: 1;
  }
  .city-num {
    display: block;
    font-family: var(--font-display);
    font-size: 26px;
    /* Dekorativ siffra: --meta nedtonad. Tidigare --border-on-paper, vilket i
       ljust läge blir #dcdcdc på vitt kort — i praktiken osynligt. */
    color: var(--meta);
    opacity: 0.5;
    transition: opacity var(--t-med) ease-out;
  }
  .city-card:hover .city-num {
    opacity: 1;
  }
  .city-num-label {
    display: block;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--meta);
    margin-top: 4px;
  }

  @media (min-width: 1024px) {
    .sheet-inner {
      padding: 0 var(--page-pad) 56px;
    }
    .float-search {
      max-width: 880px;
      margin: -40px auto 0;
    }
    .section {
      margin-top: 56px;
      padding: 0;
    }
    .section--styles {
      margin-top: 88px;
      margin-bottom: 88px;
      margin-inline: calc(-1 * var(--page-pad));
      padding: 56px var(--page-pad) 62px;
    }
    .section-head {
      margin-bottom: 22px;
    }
    .section-all {
      font-size: 13px;
    }
    .popular-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
    .featured-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
    .premium-slot {
      min-height: 305px;
      border-radius: var(--r-card-lg);
      padding: 24px;
    }
    .premium-slot-title {
      font-size: 24px;
    }
    .premium-slot-text {
      font-size: 13px;
    }
    .premium-cta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 32px;
      margin-top: 20px;
      padding: 28px 32px;
    }
    .premium-cta-title {
      font-size: 30px;
    }
    .premium-cta-btn {
      flex: none;
    }
    .pe-media {
      height: 230px;
    }
