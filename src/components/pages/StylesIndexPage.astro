---
/** Stilar-index (/tyylit/) — delad mellan fi och sv. */
import { heroBgFor } from '../../lib/heroImages';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, localePath, type Locale } from '../../i18n/ui';
import { getStylesSorted, styleDisplayName } from '../../lib/content';
import { styleImages } from '../../lib/styleImages';
import { jsonLdString, breadcrumbLd } from '../../lib/schema';
import { citiesIndexPath, guidePath } from '../../lib/routes';
import { guides } from '../../lib/guides.mjs';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const p = (path: string) => localePath(locale, path);
const site = Astro.site!;
const styles = await getStylesSorted();
// Egen titel och beskrivning (12/8 2026). Sidan ärvde site.description och sa
// därför exakt samma sak om sig själv som /tatuoijat/ gjorde.
const title = t('styles.metaTitle', { site: t('site.name') });
const jalkihoitoRoute = guides.find(
  (guide) => guide.key === 'tatuoinnin-jalkihoito' && guide.status === 'published',
);

const ink = (angle: number, from: string, to: string) =>
  `linear-gradient(${angle}deg, ${from} 0%, ${to} 100%)`;
const styleGradients = [
  ink(160, '#1e1e1e', '#2d2430'),
  ink(200, '#222222', '#33272c'),
  ink(150, '#1a1a1a', '#2a2126'),
  ink(215, '#242424', '#3a2a2e'),
  ink(170, '#202020', '#35272b'),
  ink(190, '#1e1e1e', '#2c2328'),
];

const breadcrumb = breadcrumbLd([
  { name: t('breadcrumb.home'), url: new URL(p('/'), site).href },
  { name: t('nav.styles'), url: new URL(p('/tyylit/'), site).href },
]);

// Stor fotohero (Calles beslut 10/8) — optimerad webp via getImage().
const heroBg = await heroBgFor('styles');
---

<BaseLayout
  title={title}
  description={t('styles.metaDescription')}
  locale={locale}
  path="/tyylit/"
  hasAlternate
>
  <script type="application/ld+json" set:html={jsonLdString(breadcrumb)} slot="head" />
  <section class="index-hero has-hero-photo" style={`--hero-bg:url(${heroBg})`}>
    <div class="container index-hero-inner">
      <p class="eyebrow">{t('home.styles.eyebrow')}</p>
      <h1 class="index-title">{t('home.styles.title')}</h1>
    </div>
  </section>
  <div class="sheet grain">
    <div class="container sheet-inner">
      <!-- Svara-först (GEO.md §1). Sidan var 75 ord totalt och låg på position
           19 för "tyylit" — ett rutnät utan en enda mening. Stycket står FÖRE
           rutnätet: det är sidans enda text, och den ska inte ligga under
           tolv bildkort. -->
      <p class="index-answer">{t('styles.answer')}</p>

      <div class="style-grid">
        {
          styles.map((style, index) => (
            <a class="style-card" href={p(`/tyylit/${style.id}/`)}>
              {styleImages[style.id] ? (
                <Image
                  class="style-photo"
                  src={styleImages[style.id]!}
                  alt=""
                  widths={[400, 800]}
                  sizes="(min-width: 1024px) 33vw, 50vw"
                  loading={index < 2 ? 'eager' : 'lazy'}
                />
              ) : (
                <span
                  class="style-bg grain-dark"
                  style={`background:${styleGradients[index % styleGradients.length]}`}
                  aria-hidden="true"
                />
              )}
              <span class="style-name">{styleDisplayName(style, locale)}</span>
              <span class="style-arrow" aria-hidden="true">→</span>
            </a>
          ))
        }
      </div>

      <!-- Rådgivande avsnitt under rutnätet. Bär sidans H2 och de interna
           länkar den saknade helt: hit, till städerna och till jälkihoito. -->
      <section class="index-help" aria-labelledby="styles-help-title">
        <h2 class="index-help-title" id="styles-help-title">{t('styles.helpTitle')}</h2>
        <p class="index-help-text">{t('styles.helpP1')}</p>
        <p class="index-help-text">{t('styles.helpP2')}</p>
        <ul class="index-help-links">
          <li><a class="ink-link" href={p('/hinnat/')}>{t('styles.helpLinkPrices')} →</a></li>
          <li>
            <a class="ink-link" href={p(citiesIndexPath(locale))}>
              {t('styles.helpLinkCities')} →
            </a>
          </li>
          {
            jalkihoitoRoute && (
              <li>
                <a class="ink-link" href={p(guidePath(jalkihoitoRoute, locale))}>
                  {t('styles.helpLinkAftercare')} →
                </a>
              </li>
            )
          }
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  /* Svara-först och rådgivningsavsnitt (12/8 2026). Sidan hade ingen text
     alls; de här två ytorna är hela dess innehåll och ska därför läsa som
     redaktionell text, inte som bildtext. */
  .index-answer {
    max-width: 62ch;
    margin: 0 0 26px;
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--text);
  }
  .index-help {
    margin-top: 40px;
    max-width: 62ch;
  }
  .index-help-title {
    font-size: 22px;
    line-height: 1.2;
    margin: 0 0 12px;
    color: var(--text);
  }
  .index-help-text {
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--text);
    margin: 0 0 14px;
  }
  .index-help-links {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    font-size: 14px;
    font-weight: 600;
  }

  .index-hero {
    position: relative;
    z-index: 0;
    background: var(--ink);
  }
  .index-hero-inner {
    padding: 28px var(--page-pad) 46px;
  }
  .index-title {
    font-size: 34px;
    line-height: 1.06;
    color: var(--text-light);
  }
  .sheet {
    position: relative;
    z-index: 1;
    background: var(--paper);
    border-radius: var(--r-sheet) var(--r-sheet) 0 0;
    margin-top: var(--sheet-overlap);
  }
  .sheet-inner {
    padding: 24px var(--page-pad) 40px;
  }
  .style-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .style-card {
    position: relative;
    height: 150px;
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    isolation: isolate;
  }
  .style-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    transition: transform var(--t-med) var(--ease-out);
  }
  .style-card :global(.style-photo) {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.8) contrast(0.98);
    transition: transform var(--t-med) var(--ease-out);
  }
  .style-card:hover :global(.style-photo) {
    transform: scale(1.03);
  }
  .style-card::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 60%;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(16, 16, 20, 0) 0%, rgba(16, 16, 20, 0.45) 100%);
  }
  .style-name {
    position: absolute;
    left: 14px;
    bottom: 12px;
    z-index: 1;
    font-family: var(--font-display);
    font-size: 17px;
    color: #fff;
    text-shadow: 0 1px 8px rgba(16, 16, 20, 0.5);
    transition: transform var(--t-med) var(--ease-out);
  }
  .style-arrow {
    position: absolute;
    right: 14px;
    bottom: 12px;
    z-index: 1;
    color: var(--text-light);
    font-size: 15px;
    opacity: 0.55;
    transition:
      transform var(--t-med) var(--ease-out),
      opacity var(--t-med) var(--ease-out);
  }
  .style-card:hover .style-bg {
    transform: scale(1.03);
  }
  .style-card:hover .style-name {
    transform: translateY(-4px);
  }
  .style-card:hover .style-arrow {
    opacity: 1;
    transform: translateX(3px);
  }
  @media (min-width: 1024px) {
    .index-hero-inner {
      padding: 44px var(--page-pad) 64px;
    }
    .index-title {
      font-size: 52px;
    }
    .sheet-inner {
      padding: 40px var(--page-pad) 56px;
    }
    .style-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
    .style-card {
      height: 210px;
      border-radius: var(--r-card);
    }
    .style-name {
      left: 18px;
      bottom: 15px;
      font-size: 22px;
    }
    .style-arrow {
      right: 18px;
      bottom: 15px;
      font-size: 17px;
    }
  }
</style>
