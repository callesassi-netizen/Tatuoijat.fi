---
/**
 * Prisguiden /hinnat — SEO-magneten. Long-form med hintataulukko,
 * prisfaktorer och FAQ (FAQPage-schema enligt CLAUDE.md).
 */
import { heroBgFor } from '../../lib/heroImages';
import { bodyPartImages } from '../../lib/bodyPartImages';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProseAside from '../ProseAside.astro';
import { useTranslations, localePath, type Locale } from '../../i18n/ui';
import { hinnat } from '../../data/hinnat';
import { jsonLdString, breadcrumbLd, faqLd, GUIDES_UPDATED } from '../../lib/schema';
import { citiesIndexPath, guidePath, guidesIndexPath } from '../../lib/routes';
import { publishedGuides } from '../../lib/guides.mjs';
import { guideCards } from '../../data/guides';
import heroImage from '../../assets/bilder/jalkihoito.png';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const p = (path: string) => localePath(locale, path);
const site = Astro.site!;
const c = hinnat[locale];

/**
 * Guidelänkarna läses ur registret, inte hårdkodade: en ny publicerad guide
 * dyker upp här av sig själv, och en avpublicerad försvinner.
 *
 * GUIDE_ORDER är en PRIORITERING, inte ett filter (Calle 11/8: "det är bara
 * länkat till 3 guider"). Tidigare var den båda delarna, och när de tre sista
 * guiderna skrevs blev de tysta bortsorterade härifrån — listan såg komplett
 * ut men var det inte. Nu styr ordningen bara vad som kommer först;
 * resten följer i registrets ordning.
 */
const GUIDE_ORDER = ['tatuoinnin-hoitotuotteet', 'tatuoinnin-jalkihoito', 'tatuoinnin-paraneminen'];
const guideRank = (key: string) => {
  const index = GUIDE_ORDER.indexOf(key);
  return index === -1 ? GUIDE_ORDER.length : index;
};
const relatedGuides = publishedGuides
  .map((guide, index) => ({ guide, index, card: guideCards[guide.key]?.[locale] }))
  .filter((entry) => Boolean(entry.card))
  .sort((a, b) => guideRank(a.guide.key) - guideRank(b.guide.key) || a.index - b.index);

const path = '/hinnat/';
const breadcrumb = breadcrumbLd([
  { name: t('breadcrumb.home'), url: new URL(p('/'), site).href },
  { name: c.h1, url: new URL(p(path), site).href },
]);
const faq = faqLd(c.faq);

// Stor fotohero (Calles beslut 10/8) — optimerad webp via getImage().
const heroBg = await heroBgFor('prices');

/**
 * Sidokolumnens innehållsförteckning. Rubrikerna på den här sidan bär redan
 * sina id:n för aria-labelledby, så ankarna pekar rakt på dem — inga extra
 * ankarelement behövs. scroll-padding-top i global.css håller dem fria från
 * den sticky headern.
 */
const asideItems = [
  { href: '#table-title', label: c.tableTitle },
  { href: '#bodyparts-title', label: c.bodyPartsTitle },
  { href: '#factors-title', label: c.factorsTitle },
  { href: '#faq-title', label: c.faqTitle },
  { href: '#guides-title', label: c.guidesTitle },
];
---

<BaseLayout
  title={c.metaTitle}
  description={c.metaDescription}
  locale={locale}
  path={path}
  hasAlternate
>
  <script type="application/ld+json" set:html={jsonLdString(breadcrumb)} slot="head" />
  <script type="application/ld+json" set:html={jsonLdString(faq)} slot="head" />

  <section class="guide-hero has-hero-photo" style={`--hero-bg:url(${heroBg})`}>
    <div class="container guide-hero-inner">
      <div>
        <p class="eyebrow">{c.eyebrow}</p>
        <h1 class="guide-title">{c.h1}</h1>
      </div>
    </div>
  </section>

  <div class="sheet grain reading">
    <div class="container sheet-inner">
      <div class="prose-grid">
      <div class="prose-col">
        <p class="freshness">{t('common.updated', { date: GUIDES_UPDATED })}</p>
        {c.intro.map((paragraph) => <p class="lead">{paragraph}</p>)}

        <!-- Hintataulukko -->
        <section aria-labelledby="table-title" class="block">
          <h2 class="block-title" id="table-title">{c.tableTitle}</h2>
          <div class="table-card">
            <table>
              <thead>
                <tr>{c.tableColumns.map((column) => <th scope="col">{column}</th>)}</tr>
              </thead>
              <tbody>
                {
                  c.rows.map((row) => (
                    <tr>
                      <th scope="row">{row.label}</th>
                      <td>{row.size}</td>
                      <td class="price">{row.price}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <p class="table-note">{c.tableNote}</p>
        </section>

        <!-- Hintaesimerkit kehonosittain: keyword-researchen 9/8 visade att
             den finska prisefterfrågan är KROPPSDEL + pris, inte den
             generiska huvudtermen. Bild + spann per placering. -->
        <section aria-labelledby="bodyparts-title" class="block">
          <h2 class="block-title" id="bodyparts-title">{c.bodyPartsTitle}</h2>
          <p class="block-lead">{c.bodyPartsIntro}</p>
          <div class="bodyparts">
            {
              c.bodyParts.map((part) => (
                <article class="bodypart">
                  {bodyPartImages[part.key] && (
                    <Image
                      class="bodypart-img"
                      src={bodyPartImages[part.key]!}
                      alt=""
                      widths={[300, 600]}
                      sizes="(min-width: 1024px) 30vw, 90vw"
                      loading="lazy"
                    />
                  )}
                  <div class="bodypart-body">
                    <h3 class="bodypart-label">{part.label}</h3>
                    <p class="bodypart-price">{part.price}</p>
                    <p class="bodypart-size">{part.size}</p>
                    <p class="bodypart-text">{part.text}</p>
                  </div>
                </article>
              ))
            }
          </div>
        </section>

        <!-- Prisfaktorer -->
        <section aria-labelledby="factors-title" class="block">
          <h2 class="block-title" id="factors-title">{c.factorsTitle}</h2>
          <div class="factors">
            {
              c.factors.map((factor, index) => (
                <div class="factor">
                  <span class="factor-number" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <div>
                    <h3 class="factor-title">{factor.title}</h3>
                    <p class="factor-text">{factor.text}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </section>

        <!-- FAQ -->
        <section aria-labelledby="faq-title" class="block">
          <h2 class="block-title" id="faq-title">{c.faqTitle}</h2>
          <div class="faq-list">
            {
              c.faq.map((item) => (
                <details class="faq-item">
                  <summary>
                    <span class="faq-q">{item.q}</span>
                    <span class="faq-icon" aria-hidden="true">+</span>
                  </summary>
                  <p class="faq-a">{item.a}</p>
                </details>
              ))
            }
          </div>
        </section>

        <!-- Brygga till oppaat: priset gäller stolen, resultatet avgörs efteråt -->
        {
          relatedGuides.length > 0 && (
            <section aria-labelledby="guides-title" class="block">
              <h2 class="block-title" id="guides-title">{c.guidesTitle}</h2>
              <p class="block-lead">{c.guidesIntro}</p>
              <ul class="guide-links">
                {relatedGuides.map(({ guide, card }) => (
                  <li>
                    <a class="guide-link" href={p(guidePath(guide, locale))}>
                      <span class="guide-link-title">{card!.title}</span>
                      <span class="guide-link-text">{card!.summary}</span>
                    </a>
                  </li>
                ))}
              </ul>
              <p class="guide-all">
                <a class="ink-link" href={p(guidesIndexPath(locale))}>{t('guides.h1')} →</a>
              </p>
            </section>
          )
        }

        <!-- CTA -->
        <section class="cta-block">
          <h2 class="cta-title">{c.ctaTitle}</h2>
          <p class="cta-text">{c.ctaText}</p>
          <a class="btn-cta cta-btn" href={p(citiesIndexPath(locale))}>{c.ctaLabel}</a>
        </section>
      </div>

        <!-- Sidokolumn, endast desktop. Kortet upprepar sidans CTA i stället
             för att uppfinna en ny: den som läst prisspannet och blivit klar
             ska kunna gå vidare utan att scrolla till botten. -->
        <ProseAside
          title={t('guide.contentsTitle')}
          items={asideItems}
          card={{
            href: p(citiesIndexPath(locale)),
            title: c.ctaTitle,
            text: c.ctaText,
            cta: c.ctaLabel,
          }}
        />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* Guidelänkar — kort med rubrik + sammanfattning, inte en naken lista.
     Sammanfattningen är det som gör att någon faktiskt klickar. */
  .guide-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .guide-link {
    display: block;
    background: var(--surface);
    border: var(--card-border);
    border-radius: var(--r-card);
    padding: 15px 16px;
    text-decoration: none;
    transition:
      border-color var(--t-fast) var(--ease-out),
      transform var(--t-fast) var(--ease-out);
  }
  .guide-link:hover {
    border-color: var(--flash);
    transform: translateY(-2px);
  }
  .guide-link-title {
    display: block;
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: 17px;
    line-height: 1.2;
    color: var(--text);
  }
  .guide-link-text {
    display: block;
    margin-top: 5px;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--meta);
  }
  .guide-all {
    margin: 14px 0 0;
    font-size: 13.5px;
    font-weight: 600;
  }
  .guide-all a {
    color: var(--text);
  }
  /* TVÅ kolumner, inte tre. Korten ligger inne i textkolumnens 720 px, och
     tre spalter där ger ~230 px per kort — sammanfattningen bryts då på sex
     rader och det är sammanfattningen som får någon att klicka. Sedan alla
     sex guider listas här (11/8) blev det dessutom två fulla rader smala kort
     i stället för en. */
  @media (min-width: 640px) {
    .guide-links {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }
    .guide-link {
      padding: 18px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .guide-link:hover {
      transform: none;
    }
  }

  /* Hintaesimerkit kehonosittain */
  .block-lead {
    font-size: 15px;
    line-height: 1.6;
    color: var(--meta);
    margin: 0 0 20px;
    max-width: 62ch;
  }
  .bodyparts {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }
  .bodypart {
    background: var(--surface);
    border: var(--card-border);
    border-radius: var(--r-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .bodypart :global(.bodypart-img) {
    width: 100%;
    height: 170px;
    object-fit: cover;
    display: block;
    filter: var(--img-filter);
  }
  .bodypart-body {
    padding: 14px 16px 18px;
  }
  .bodypart-label {
    font-size: 19px;
    color: var(--text);
    margin: 0;
  }
  .bodypart-price {
    font-family: var(--font-display);
    font-weight: var(--weight-display-strong);
    font-size: 22px;
    color: var(--flash);
    margin: 6px 0 0;
  }
  .bodypart-size {
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--meta);
    margin: 2px 0 0;
  }
  .bodypart-text {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--meta);
    margin: 10px 0 0;
  }
  @media (min-width: 700px) {
    .bodyparts {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1024px) {
    .bodyparts {
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }
    .bodypart :global(.bodypart-img) {
      height: 190px;
    }
  }

  .guide-hero {
    position: relative;
    z-index: 0;
    background: var(--ink);
  }
  .guide-hero-inner {
    padding: 28px var(--page-pad) 52px;
  }
  .guide-hero-media {
    margin-top: 20px;
    border-radius: var(--r-card);
    overflow: hidden;
  }
  .guide-hero-media :global(img) {
    width: 100%;
    height: 180px;
    object-fit: cover;
    display: block;
    filter: saturate(0.9);
  }
  .guide-title {
    font-size: 36px;
    line-height: 1.04;
    color: var(--text-light);
    max-width: 560px;
  }

  .sheet {
    position: relative;
    z-index: 1;
    background: var(--paper);
    border-radius: var(--r-sheet) var(--r-sheet) 0 0;
    margin-top: var(--sheet-overlap);
  }
  .sheet-inner {
    padding: 28px var(--page-pad) 48px;
  }
  /* .prose-grid/.prose-col bor i src/styles/global.css — samma layout som
     guidesidorna. Sidokolumnen är ProseAside.astro. */
  .lead {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text);
    margin: 0 0 14px;
  }

  .freshness {
    margin: 0 0 16px;
    font-size: 11.5px;
    color: var(--meta);
  }

  .block {
    margin-top: 40px;
  }
  .block-title {
    font-size: 22px;
    color: var(--text);
    margin-bottom: 16px;
  }

  .table-card {
    background: var(--surface);
    border: var(--card-border);
    border-radius: var(--r-card);
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
  }
  thead th {
    text-align: left;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--meta);
    padding: 14px 16px 10px;
    border-bottom: var(--card-border);
  }
  tbody th,
  tbody td {
    text-align: left;
    padding: 12px 16px;
    border-bottom: var(--card-border);
    color: var(--text);
    font-weight: 400;
  }
  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }
  tbody th {
    font-weight: 600;
    white-space: nowrap;
  }
  tbody td:nth-child(2) {
    color: var(--meta);
  }
  .price {
    font-family: var(--font-display);
    font-size: 13px;
    white-space: nowrap;
  }
  .table-note {
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--meta);
    margin: 12px 2px 0;
  }

  .factors {
    display: grid;
    gap: 18px;
  }
  .factor {
    display: flex;
    gap: 14px;
  }
  .factor-number {
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 1.1;
    color: var(--border-on-paper);
  }
  .factor-title {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    color: var(--text);
    margin: 0;
  }
  .factor-text {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--meta);
    margin: 4px 0 0;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .faq-item {
    background: var(--surface);
    border: var(--card-border);
    border-radius: var(--r-card);
    padding: 0 16px;
  }
  .faq-item summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 15px 0;
    cursor: pointer;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-q {
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
  }
  .faq-icon {
    font-size: 18px;
    color: var(--meta);
    transition: transform var(--t-fast) ease-out;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }
  .faq-a {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--text);
    margin: 0;
    padding: 0 0 16px;
  }

  .cta-block {
    margin-top: 48px;
    background: var(--ink);
    border-radius: var(--r-card-lg);
    padding: 26px 22px;
    text-align: center;
  }
  .cta-title {
    font-size: 22px;
    color: var(--text-light);
  }
  .cta-text {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--meta-on-ink);
    max-width: 380px;
    margin: 8px auto 18px;
  }
  .cta-btn {
    display: inline-block;
    width: auto;
    padding: 14px 30px;
  }

  @media (min-width: 1024px) {
    .guide-hero-inner {
      padding: 44px var(--page-pad) 76px;
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 48px;
      align-items: center;
    }
    .guide-hero-media {
      margin-top: 0;
      border-radius: var(--r-card-lg);
    }
    .guide-hero-media :global(img) {
      height: 260px;
    }
    .guide-title {
      font-size: 64px;
    }
    .sheet {
      margin-top: var(--sheet-overlap);
    }
    .sheet-inner {
      padding: 44px var(--page-pad) 64px;
    }
    .lead {
      font-size: 16px;
    }
    .block {
      margin-top: 56px;
    }
    .block-title {
      font-size: 30px;
      margin-bottom: 20px;
    }
    table {
      font-size: 14.5px;
    }
    .factors {
      grid-template-columns: 1fr 1fr;
      gap: 24px 32px;
    }
    .cta-block {
      padding: 40px;
    }
    .cta-title {
      font-size: 30px;
    }
  }
</style>
